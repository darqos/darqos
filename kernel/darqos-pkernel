# Run the installed p-kernel, from its systemd unit: with the venv's
# Python, first on PATH too, as when it's activated, and the darq
# package from the installation root (installed as source, not a
# wheel).

DARQ=/darq

cd "$DARQ" || exit 1
export PYTHONPATH="$DARQ"
export PATH="$DARQ/env/bin:$PATH"
exec "$DARQ/env/bin/python" "$DARQ/kernel/pkernel"
