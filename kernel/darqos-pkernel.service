# The p-kernel, as the darq user's login session on tty1 (see
# doc/terminal.rst, "Session and Login"): pam_systemd makes it a logind
# session, so the compositor gets its seat through libseat, and
# /run/user/<uid> exists.  It replaces the getty there.

[Unit]
Description=DarqOS p-Kernel
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service
# A broken install stops restarting: the way in is then SSH.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=darq
Group=darq
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user DARQ_MACHINE=1
# What it writes in /darq/run is darq's alone.
UMask=0077
ExecStart=/darq/kernel/darqos-pkernel
# A clean exit (shutdown) is final: only restart after a failure.
Restart=on-failure
RestartSec=1
# Stopping it is a shutdown: SIGTERM to the p-kernel alone, which shuts
# its processes down, then SIGKILL for anything left.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=darqos.target
