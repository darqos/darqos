    def handle_spawn_process(self,
                             process: KernelProcessState,
                             request: pk.SpawnProcessRequest):
        """Handle request to spawn a new user process.

        The request is answered once the new process reports that it's
        running, or immediately if it couldn't be started."""

        exec_path = request.get_exec_path()
        if self._stopping:
            logging.warning(f"{process.name()} spawn_process({exec_path}) "
                            f"refused: shutting down")
            self.send_spawn_process_response(process, request.request_id, 0,
                                             1,  # FIXME: better errno
                                             "shutting down")
            return

        if not os.path.isfile(os.path.join(exec_path, "main.py")):
            logging.warning(f"{process.name()} spawn_process({exec_path}) "
                            f"failed: no main.py")
            self.send_spawn_process_response(process, request.request_id, 0,
                                             1,  # FIXME: better errno
                                             f"no main.py in {exec_path}")
            return

        try:
            dpid = self.do_spawn_process(process, exec_path)
        except OSError as e:
            logging.warning(f"{process.name()} spawn_process({exec_path}) "
                            f"failed: {e}")
            self.send_spawn_process_response(process, request.request_id, 0,
                                             1,  # FIXME: better errno
                                             str(e))
            return

        self._process_table[dpid].set_spawn_request(process, request.request_id)
        return

    def send_spawn_process_response(self,
                                    process: KernelProcessState,
                                    request_id: int,
                                    dpid: int,
                                    result: int,
                                    error: str|None = None):
        response = pk.SpawnProcessResponse(request_id, result, dpid, error)
        buf = response.encode()
        process.send_data(buf)
        logging.info(f"spawn_process response: "
                     f"request_id={request_id}, dpid={dpid}, result={result}, error={error}")
        return

    def handle_kill_process_request(self,
                                    process: KernelProcessState,
                                    request: pk.KillProcessRequest):
        """Handle request to kill a user process.

        The request is forwarded to the target process, and answered
        once the target's p-call session closes."""

        target = self._process_table.get(request.dpid)
        status = target.get_status() if target is not None else None
        if target is None or status not in (KernelProcessStatus.RUNNING, KernelProcessStatus.SPAWNED):
            logging.warning(f"{process.name()} kill_process({request.dpid}) "
                            f"failed: no such running process")
            self.send_kill_process_response(process, request.request_id,
                                            1)  # FIXME: better errno
            return

        logging.info(f"{process.name()} kill_process({request.dpid})")
        target.add_kill_request(process, request.request_id)

        if status == KernelProcessStatus.SPAWNED:
            # It can't be asked to exit yet: kill its host process.  The
            # kill is answered when that's reaped.
            self.kill_host_process(target)
            return

        target.send_data(pk.KillProcessRequest(0, request.dpid).encode())
        self.after(KILL_TIMEOUT, lambda: self.check_killed(target))
        return

    def check_killed(self, process: KernelProcessState):
        """Kill the host process of a killed process that hasn't disconnected."""
        if process.get_status() != KernelProcessStatus.RUNNING:
            return

        logging.error(f"{process.name()} didn't exit within {KILL_TIMEOUT}s of being killed")
        self.kill_host_process(process)
        return

    def send_kill_process_response(self,
                                   process: KernelProcessState,
                                   request_id: int,
                                   result: int):
        response = pk.KillProcessResponse(request_id, result)
        process.send_data(response.encode())
        logging.info(f"kill_process response: "
                     f"request_id={request_id}, result={result}")
        return

    def remove_process(self, process: KernelProcessState):
        """Remove a process from the process table.

        Its host process is still reaped, when it exits."""
        self._process_table.pop(process.get_dpid(), None)
        # Poll now: if it has already exited, no SIGCHLD will prompt it.
        child = process.get_child()
        if child is not None and child.poll() is None:
            self._unreaped.append(child)
        return

    def reap_children(self):
        """Collect the exit status of any exited child processes."""
        for child in list(self._unreaped):
            if child.poll() is not None:
                logging.info(f"Host process [{child.pid}] exited with status {child.returncode}")
                self._unreaped.remove(child)

        for process in list(self._process_table.values()):
            child = process.get_child()
            if child is None or child.returncode is not None:
                continue

            status = child.poll()
            if status is None:
                continue

            logging.info(f"{process.name()} host process [{child.pid}] "
                         f"exited with status {status}")

            # A process that exits before it's running won't disconnect,
            # so its spawn request must be answered here.  Its spawn failed,
            # so it's never a child to wait for: forget it.
            if process.get_status() == KernelProcessStatus.SPAWNED:
                process.set_status(KernelProcessStatus.LOST)
                process.set_exit_reason(pk.ExitReason.LOST)
                self.remove_process(process)
                spawn_request = process.take_spawn_request()
                if spawn_request is not None:
                    requester, request_id = spawn_request
                    self.send_spawn_process_response(
                        requester, request_id, 0,
                        1,  # FIXME: better errno
                        f"process exited with status {status} before running")

                for requester, request_id in process.take_kill_requests():
                    if requester is not None:
                        self.send_kill_process_response(requester, request_id, 0)

        self.check_shutdown()
        return

    # Waiting for children

    def process_finished(self, process: KernelProcessState):
        """Handle a process becoming a ZOMBIE or LOST.

        It's kept until its parent collects it with wait.  A process the
        p-kernel spawned (parent dpid 0) is kept for the p-kernel; an
        orphan, whose parent has already finished, can never be
        collected, so it's removed at once.  So are the parent's own
        finished children, which become orphans."""
        dpid = process.get_dpid()

        for child in list(self._process_table.values()):
            if child.get_parent_dpid() == dpid and child.is_finished():
                logging.info(f"{child.name()} removed: orphaned")
                self.remove_process(child)

        parent_dpid = process.get_parent_dpid()
        if parent_dpid != 0:
            parent = self._process_table.get(parent_dpid)
            if parent is None or parent.is_finished():
                logging.info(f"{process.name()} removed: orphaned")
                self.remove_process(process)
            else:
                self.answer_wait_requests(parent)

        self.check_shutdown()
        return

    def finished_child(self, parent: KernelProcessState, dpid: int) -> KernelProcessState | None:
        """Return a finished child of a process, or None.

        :param dpid: Child's dpid, or zero for any (the earliest spawned)."""
        for child in sorted(self._process_table.values(), key=lambda p: p.get_dpid()):
            if (child.get_parent_dpid() == parent.get_dpid() and child.is_finished()
                    and dpid in (0, child.get_dpid())):
                return child
        return None

    def has_child(self, parent: KernelProcessState, dpid: int) -> bool:
        """Return True if a process has a child (any, if dpid is zero)."""
        return any(child.get_parent_dpid() == parent.get_dpid() and dpid in (0, child.get_dpid())
                   for child in self._process_table.values())

    def handle_wait_request(self, process: KernelProcessState, request: pk.WaitRequest):
        """Collect a finished child of the process.

        A finished child is reported and removed from the process table.
        If none has finished, a blocking wait is answered when one does;
        a non-blocking one is answered at once, with NOT_FINISHED."""
        if not self.has_child(process, request.dpid):
            logging.warning(f"{process.name()} wait({request.dpid}) failed: no such child")
            response = pk.WaitResponse(request.request_id, pk.WaitResult.NO_SUCH_CHILD)
            process.send_data(response.encode())
            return

        child = self.finished_child(process, request.dpid)
        if child is not None:
            self.collect_child(process, request.request_id, child)
            return

        if request.blocking:
            logging.info(f"{process.name()} wait({request.dpid}) waiting")
            self._wait_requests.setdefault(process.get_dpid(), []).append(
                (process, request.request_id, request.dpid))
            return

        response = pk.WaitResponse(request.request_id, pk.WaitResult.NOT_FINISHED)
        process.send_data(response.encode())
        return

    def answer_wait_requests(self, parent: KernelProcessState):
        """Answer a parent's blocking waits, with its finished children."""
        requests = self._wait_requests.pop(parent.get_dpid(), [])
        remaining = []
        for request in requests:
            _, request_id, dpid = request
            child = self.finished_child(parent, dpid)
            if child is None:
                remaining.append(request)
            else:
                self.collect_child(parent, request_id, child)

        if remaining:
            self._wait_requests[parent.get_dpid()] = remaining
        return

    def collect_child(self, parent: KernelProcessState, request_id: int, child: KernelProcessState):
        """Report a finished child to its parent, and remove it."""
        reason = child.get_exit_reason()
        assert reason is not None, "finished process has no exit reason"
        status = child.get_exit_status()
        if reason != pk.ExitReason.EXITED or status is None:
            status = -1

        logging.info(f"{parent.name()} collected {child.name()}: {reason.name}, status {status}")
        self.remove_process(child)
        response = pk.WaitResponse(request_id, pk.WaitResult.OK, child.get_dpid(),
                                     reason, status, child.get_exit_error())
        parent.send_data(response.encode())
        return

    def get_next_dpid(self) -> int:
        dpid = self._next_dpid
        self._next_dpid += 1
        return dpid


    @staticmethod
    def get_loader_environment() -> dict[str, str]:
        """Return the environment for a language stub process.

        It's this process' environment, with the darq package's location
        prepended to PYTHONPATH."""
        env = dict(os.environ)
        paths = [DARQ_PYTHON_PATH]
        if env.get("PYTHONPATH"):
            paths.append(env["PYTHONPATH"])
        env["PYTHONPATH"] = os.pathsep.join(paths)
        return env

    def do_spawn_process(self, parent: KernelProcessState | None, exec_path: str) -> int:
        """Spawn a new user process.

        :param parent: the process requesting the new process, if any.
        :param exec_path: the path to the executable.
        :return: the DarqOS process identifier (DPID).
        :raises OSError: if the language stub can't be started."""
        logging.info(f"do_spawn_process({exec_path})")

        # Identify the type of the executable (FIXME: always Python for now)
        dpid = self.get_next_dpid()
        parent_dpid = parent.get_dpid() if parent is not None else 0

        # Fork and exec the language stub.  The path comes from the
        # requesting process, so it's passed as an argument, not via a shell.
        port = self.socket.getsockname()[1]
        child = subprocess.Popen([PYTHON_IMAGE_LOADER, str(port), str(dpid), str(parent_dpid), exec_path],
                                 close_fds=True,
                                 cwd="/",
                                 env=self.get_loader_environment())  # FIXME: audit list, and add any more needed here

        # Create process table entry.
        entry = KernelProcessState(self, dpid, exec_path)
        entry.set_child(child)
        entry.set_status(KernelProcessStatus.SPAWNED)
        entry.set_parent_dpid(parent_dpid)
        self._process_table[dpid] = entry  # No fd/socket yet

        # When the stub starts, it'll connect and send a RunRequest,
        # triggering the spawn_process_response.  If it doesn't, kill it,
        # so the spawn fails.
        self.after(SPAWN_TIMEOUT, lambda: self.check_spawned(entry))
        return dpid

    def check_spawned(self, process: KernelProcessState):
        """Kill the host process of a spawned process that isn't running yet."""
        if process.get_status() != KernelProcessStatus.SPAWNED:
            return

        logging.error(f"{process.name()} didn't send RUN_REQUEST within {SPAWN_TIMEOUT}s")
        self.kill_host_process(process)
        return

    def handle_run_request(self, incoming_connection, message: pk.RunRequest):
        """Handle a newly-spawned user process asking to run.

        The process waits for the RunResponse before starting its
        application."""
        logging.info(f"Socket [{incoming_connection.get_socket().fileno()}] handle_run_request(dpid={message.dpid})")

        # Add socket and fd table entries.
        process = self._process_table.get(message.dpid)
        if not process:
            logging.error(f"WTF, no process table entry for RUN_REQUEST with DPID {message.dpid}")
            self.reject_run_request(incoming_connection)
            return

        # Only a newly-spawned process can ask to run.
        if process.get_status() != KernelProcessStatus.SPAWNED:
            logging.error(f"RUN_REQUEST for DPID {message.dpid} rejected: "
                          f"process is {process.get_status().name}, not SPAWNED")
            self.reject_run_request(incoming_connection)
            return

        # Remove incoming connection handler.
        sock = incoming_connection.get_socket()
        del self.incoming_connections[sock]

        self._processes[sock] = process
        process.set_socket(sock)

        # Update process table state.
        process.set_status(KernelProcessStatus.RUNNING)
        process.set_host_pid(message.host_pid)

        # Let the process start its application.
        process.send_data(pk.RunResponse(0).encode())

        # Answer the request that spawned this process.
        spawn_request = process.take_spawn_request()
        if spawn_request is not None:
            requester, request_id = spawn_request
            self.send_spawn_process_response(requester, request_id,
                                             process.get_dpid(), 0)

        # Hand over anything received after the RUN_REQUEST message.
        leftover = incoming_connection.get_buffer()
        if leftover.length() > 0:
            process.get_buffer().append(leftover.peek(leftover.length()))
            leftover.consume(leftover.length())
            self.dispatch(process)
        return


    def reject_run_request(self, incoming_connection):
        """Refuse a RunRequest, and close the connection."""
        try:
            incoming_connection.get_socket().sendall(pk.RunResponse(1).encode())  # FIXME: better errno
        except OSError as e:
            logging.warning(f"{incoming_connection.name()} couldn't send RUN_RESPONSE: {e}")
        self.handle_incoming_disconnect(incoming_connection)
        return

    def handle_open_port_request(self,
                                 process: KernelProcessState,
                                 request: pk.OpenPortRequest):
        """Handle request for a new port: the process gets its receive right."""
        port = self.create_port(process)
        handle = process.add_right(port, PortRight.RECEIVE)

        logging.info(f"{process.name()} open_port() created {port}, handle {handle}")
        self.send_open_port_response(process, request.request_id, 0, handle)
        return

    def handle_close_port_request(self,
                                  process: KernelProcessState,
                                  request: pk.ClosePortRequest):
        """Handle request to close a handle.

        Closing a receive right destroys the port; closing a send right
        just gives it up."""
        handle = request.port
        entry = process.remove_handle(handle)
        if entry is None:
            logging.warning(f"{process.name()} close_port({handle}) failed: bad handle")
            self.send_close_port_response(process, request.request_id, 1, handle)  # FIXME: better errno
            return

        if entry.right == PortRight.RECEIVE:
            self.destroy_port(entry.port)

        logging.info(f"{process.name()} close_port({handle}) closed its "
                     f"{entry.right.name} right to {entry.port}")
        self.send_close_port_response(process, request.request_id, 0, handle)
        return

    def handle_send_message_request(self,
                                    sender: KernelProcessState,
                                    message: pk.SendMessageRequest):
        """Handle request to send a message from connected client.

        The source and destination are the sender's handles: they're
        translated into the receiver's (see doc/ipc.rst).  The sender is
        answered after delivery, so a message to its own port is queued
        before its send_message() returns.

        :param sender: Client session that received this message.
        :param message: Received message."""
        name = sender.name()

        def refuse(result: pk.SendResult, reason: str):
            logging.warning(f"{name} send_message({message.source}, {message.destination}) "
                            f"refused: {reason}")
            response = pk.SendMessageResponse(message.request_id, result)
            sender.send_data(response.encode())

        # The source must be one of the sender's own ports, since that's
        # where replies go.
        source = sender.get_handle(message.source)
        if source is None:
            refuse(pk.SendResult.BAD_HANDLE, "bad source handle")
            return
        if source.right != PortRight.RECEIVE:
            refuse(pk.SendResult.NOT_RECEIVE_RIGHT, "source isn't a receive right")
            return

        destination = sender.get_handle(message.destination)
        if destination is None:
            refuse(pk.SendResult.BAD_HANDLE, "bad destination handle")
            return

        port = destination.port
        receiver = port.owner
        if not port.alive or receiver is None:
            refuse(pk.SendResult.DEAD_PORT, f"{port} is dead")
            return

        # Check all the transferred handles before granting any rights,
        # so a refused message transfers nothing.
        if len(message.handles) > pk.MAX_HANDLES:
            refuse(pk.SendResult.TOO_MANY_HANDLES,
                   f"{len(message.handles)} handles, at most {pk.MAX_HANDLES}")
            return
        transferred = []
        for handle in message.handles:
            entry = sender.get_handle(handle)
            if entry is None:
                refuse(pk.SendResult.BAD_HANDLE, f"bad transferred handle {handle}")
                return
            if not entry.port.alive:
                refuse(pk.SendResult.DEAD_PORT, f"transferred {entry.port} is dead")
                return
            transferred.append(entry.port)

        # Translate into the receiver's handles.  It gets a send right to
        # the source port, so it can reply, and to each transferred port.
        destination_handle = receiver.handle_for(port)
        assert destination_handle is not None, "owner has no handle for its port"
        source_handle = receiver.add_right(source.port, PortRight.SEND)
        handles = [receiver.add_right(p, PortRight.SEND) for p in transferred]

        deliver = pk.DeliverMessage(source_handle, destination_handle)
        deliver.set_payload(message.payload)
        deliver.set_handles(handles)
        receiver.send_data(deliver.encode())

        logging.info(f"{name} send_message() from {source.port} to {port}, "
                     f"delivered to {receiver.name()} "
                     f"(handles {source_handle} to {destination_handle}"
                     f"{f', transferring {handles}' if handles else ''})")
        response = pk.SendMessageResponse(message.request_id, pk.SendResult.OK)
        sender.send_data(response.encode())
        return

    def handle_register_name_request(self,
                                     process: KernelProcessState,
                                     request: pk.RegisterNameRequest):
        """Register a name for one of the process' ports.

        Names reserved for system services (see is_reserved_name) may
        only be registered by processes the p-kernel spawned itself, which
        have no parent.  Any blocking lookups waiting for the name are
        answered."""
        name = self.decode_name(request)
        entry = process.get_handle(request.port)

        if name is None:
            result = pk.NameResult.INVALID_NAME
        elif entry is None or entry.right != PortRight.RECEIVE:
            result = pk.NameResult.BAD_HANDLE
        elif self.is_reserved_name(name) and process.get_parent_dpid() != 0:
            result = pk.NameResult.RESERVED_NAME
        elif name in self._names:
            result = pk.NameResult.NAME_TAKEN
        elif entry.port.name is not None:
            result = pk.NameResult.PORT_ALREADY_NAMED
        else:
            result = pk.NameResult.OK

        if result != pk.NameResult.OK:
            logging.warning(f"{process.name()} register_name({name!r}, {request.port}) "
                            f"failed: {result.name}")
            process.send_data(pk.RegisterNameResponse(request.request_id, result).encode())
            return

        assert name is not None and entry is not None
        port = entry.port
        port.name = name
        self._names[name] = port
        logging.info(f"{process.name()} registered '{name}' for {port}")
        process.send_data(pk.RegisterNameResponse(request.request_id, result).encode())

        for waiter, request_id, _ in self._name_waiters.pop(name, []):
            self.answer_lookup(waiter, request_id, port)
        return

    def handle_lookup_name_request(self,
                                   process: KernelProcessState,
                                   request: pk.LookupNameRequest):
        """Give the process a send right to a named port.

        If the name isn't registered, a blocking lookup is answered once
        it is; a non-blocking one is answered at once, with NOT_FOUND."""
        name = self.decode_name(request)
        if name is None:
            logging.warning(f"{process.name()} lookup_name() failed: invalid name")
            response = pk.LookupNameResponse(request.request_id, pk.NameResult.INVALID_NAME, 0)
            process.send_data(response.encode())
            return

        port = self._names.get(name)
        if port is not None:
            self.answer_lookup(process, request.request_id, port)
            return

        if request.blocking:
            logging.info(f"{process.name()} lookup_name({name!r}) waiting for registration")
            self._name_waiters.setdefault(name, []).append(
                (process, request.request_id, time.monotonic()))
            return

        logging.info(f"{process.name()} lookup_name({name!r}): not found")
        response = pk.LookupNameResponse(request.request_id, pk.NameResult.NOT_FOUND, 0)
        process.send_data(response.encode())
        return

    @staticmethod
    def answer_lookup(process: KernelProcessState, request_id: int, port: KernelPortState):
        """Give a process a send right to a port, answering its lookup."""
        handle = process.add_right(port, PortRight.SEND)
        logging.info(f"{process.name()} lookup_name({port.name!r}) gave handle {handle} for {port}")
        response = pk.LookupNameResponse(request_id, pk.NameResult.OK, handle)
        process.send_data(response.encode())
        return

