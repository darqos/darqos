# TCP listening port for connection of IPC clients, on the loopback
# interface only.
TCP_HOST = "127.0.0.1"
TCP_PORT = 11000

# Seconds to wait for processes to exit at shutdown, before killing their
# host processes.
SHUTDOWN_TIMEOUT = 5.0

# Seconds to wait for a spawned process to send RUN_REQUEST, before killing
# its host process (so the spawn fails).
SPAWN_TIMEOUT = 10.0

# Seconds to wait for a killed process to disconnect, before killing its
# host process (so the kill succeeds).
KILL_TIMEOUT = 5.0

# Seconds between warnings about blocking name lookups still waiting.
# They're legitimate, so they don't time out, but a long wait is likely a
# boot ordering problem.
LOOKUP_WARNING_INTERVAL = 30.0

# Loader for Python executables, installed alongside the p-kernel.
PYTHON_IMAGE_LOADER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pyloader")

# Directory containing the darq package this p-kernel is using, so the
# loader can import the same one.
DARQ_PYTHON_PATH = os.path.dirname(os.path.dirname(os.path.abspath(darq.__file__)))


class KernelProcessStatus(IntEnum):
    """Process statuses."""

    # Table entry created, but process not yet spawned.
    ALLOCATED = 0

    # Process spawned, but not yet received its RunRequest.
    SPAWNED = 1

    # Process running.
    RUNNING = 2

    # Process has exited, but no-one has collected the exit status yet.
    ZOMBIE = 3

    # The p-call session to the process has closed unexpectedly.
    LOST = 4


class PortRight(IntEnum):
    """Right to a port held through a process' handle (see doc/ipc.rst)."""

    # The one right to receive the port's messages, held by the process
    # that created it.  It also allows sending to the port.
    RECEIVE = 1

    # A right to send messages to the port.
    SEND = 2


class KernelPortState:
    """A port: a destination for messages.

    Processes never see ports, only handles for their rights to them:
    see KernelProcessState's handle table."""

    def __init__(self, port_id: int, owner: "KernelProcessState"):
        """Constructor.

        :param port_id: Internal identifier, for logging only.
        :param owner: Process holding the port's receive right."""

        # Never sent to processes: their handles identify ports.
        self.port_id: int = port_id

        # Process holding the receive right, while the port is alive.
        self.owner: KernelProcessState | None = owner

        # Cleared when the port is destroyed: handles other processes
        # hold for it are then dead.
        self.alive: bool = True

        # Name registered for the port, if any.
        self.name: str | None = None

    def __repr__(self) -> str:
        return f"port [{self.port_id}]"


class HandleEntry:
    """A process' right to a port, in its handle table."""

    def __init__(self, port: KernelPortState, right: PortRight):
        self.port = port
        self.right = right


class KernelProcessState:
    """Kernel state for a process."""

    # The p-kernel provides facilities to create and destroy
    # processes.  In the p-kernal, each DarqOS process is implemented
    # by a Unix process: this is called the p-process.  That p-process
    # must run a language-specific stub that connects to the p-kernel
    # via TCP (or perhaps Unix domain?) socket, to implement the
    # p-call mechanism for interaction with the p-kernel.
    #
    # The kernel-side state for each p-process consists of:
    # - the Unix process PID
    # - the terminating socket for the p-process
    # - a table of ports created by the p-process
    # - the executable item running in the process
    #
    # To actually start a process, the p-kernel execs the appropriate
    # language stub executable, depending on the type of the
    # executable image.  The most common image type for 1ed will be
    # Python.  Python executable images consist of a zip file
    # containing the Python code to be executed.  It is unzipped in a
    # temporary directory.  The Python stub is executed, which invokes
    # the interpreter.  The temporary directory is added to the system
    # path, and the executable is loaded by importing and calling the
    # default function: darq_main().
    #
    # The temporary directory containing the actual code is cached:
    # multiple instances of the same executable share the same
    # unpacked zip file.
    
    def __init__(self, kernel, dpid: int, image_path: str):
        """Constructor.

        :param kernel: Reference to owning p-kernel instance.
        :param dpid: DarqOS process identifier for this process.
        :param image_path: Path to the image for this process."""

        self._kernel = kernel

        # Directory path containing the "image" (tree of Python files) for this process.
        # FIXME: this should become a zip file, and ultimately a zip-format blob loaded from the storage service.
        self._image_path = image_path

        # DarqOS PID.
        self._dpid: int = dpid

        # Host PID.
        self._hpid: int = 0

        # Parent DPID
        self._parent_dpid: int = 0

        # Process status.
        self._status: KernelProcessStatus = KernelProcessStatus.ALLOCATED

        # Handle table: this process' rights to ports, by handle.  Each
        # port has at most one handle, so the reverse mapping finds it.
        # Handles are never reused.
        self._handles: dict[int, HandleEntry] = {}
        self._port_handles: dict[KernelPortState, int] = {}
        self._next_handle: int = 1

        # Socket for this p-process' connection to the p-kernel.
        self._sock: socket.socket | None = None

        # Outbound (to p-process) data queue.
        self._send_buffer: bytes = b''

        # Inbound (from p-process) data queue.
        self._recv_buffer = pk.Buffer()

        # Kill requests awaiting this process' exit: (requester, request_id).
        self._kill_requests: list[tuple["KernelProcessState | None", int]] = []

        # Spawn request awaiting this process' RunRequest, if any.
        self._spawn_request: tuple["KernelProcessState", int] | None = None

        # Host process running the language stub (see also _hpid).
        self._child: subprocess.Popen | None = None

        # Application's exit status and error description, once it has
        # reported its exit (see the future wait() p-call).
        self._exit_status: int | None = None
        self._exit_error: str | None = None

        # How the process finished, once it's a ZOMBIE or LOST.
        self._exit_reason: pk.ExitReason | None = None

    def name(self) -> str:
        """(Internal) Log message prefix."""
        return f'kproc [{self._dpid}]'

    def get_socket(self) -> socket.socket | None:
        """Return the TCP socket connected to this client."""
        return self._sock

    def set_socket(self, sock: socket.socket | None):
        self._sock = sock

    def set_dpid(self, dpid: int):
        self._dpid = dpid

    def get_dpid(self) -> int:
        return self._dpid

    def set_host_pid(self, host_pid: int):
        self._hpid = host_pid

    def get_host_pid(self) -> int:
        return self._hpid

    def set_parent_dpid(self, parent_dpid):
        self._parent_dpid = parent_dpid

    def get_parent_dpid(self) -> int:
        return self._parent_dpid

    def set_status(self, status: KernelProcessStatus):
        """Set process status code."""
        self._status = status

    def get_status(self) -> KernelProcessStatus:
        return self._status

    # Handles

    def add_right(self, port: KernelPortState, right: PortRight) -> int:
        """Give this process a right to a port.

        A process has at most one handle for each port: if it already
        has one, that handle is returned.  A receive right includes the
        right to send, so a send right adds nothing to it.

        :param port: Port to which the right is given.
        :param right: Right given.
        :returns: This process' handle for the port."""
        handle = self._port_handles.get(port)
        if handle is not None:
            return handle

        handle = self._next_handle
        self._next_handle += 1
        self._handles[handle] = HandleEntry(port, right)
        self._port_handles[port] = handle
        return handle

    def get_handle(self, handle: int) -> HandleEntry | None:
        """Return the right a handle refers to, or None if it's not open."""
        return self._handles.get(handle)

    def handle_for(self, port: KernelPortState) -> int | None:
        """Return this process' handle for a port, or None if it has none."""
        return self._port_handles.get(port)

    def remove_handle(self, handle: int) -> HandleEntry | None:
        """Close a handle.

        :returns: The right it referred to, or None if it wasn't open."""
        entry = self._handles.pop(handle, None)
        if entry is not None:
            del self._port_handles[entry.port]
        return entry

    def take_handles(self) -> list[HandleEntry]:
        """Close all this process' handles.

        :returns: The rights they referred to."""
        entries = list(self._handles.values())
        self._handles.clear()
        self._port_handles.clear()
        return entries

    def set_child(self, child: subprocess.Popen):
        """Record the Popen object for this p-process."""
        self._child = child

    def get_child(self) -> subprocess.Popen | None:
        """Retrieve the Popen object for this p-process"""
        return self._child

    # Spawn request

    def set_spawn_request(self, requester: "KernelProcessState", request_id: int):
        """Record the request that spawned this process, to be answered once running."""
        self._spawn_request = (requester, request_id)

    def take_spawn_request(self) -> tuple["KernelProcessState", int] | None:
        """Return and clear the pending spawn request for this process."""
        request = self._spawn_request
        self._spawn_request = None
        return request

    # Exit

    def set_exit(self, status: int, error: str | None):
        """Record the application's exit status and error description."""
        self._exit_status = status
        self._exit_error = error

    def has_exited(self) -> bool:
        """Return True if the application has reported its exit."""
        return self._exit_status is not None

    def get_exit_status(self) -> int | None:
        """Return the application's exit status, or None if it hasn't exited."""
        return self._exit_status

    def get_exit_error(self) -> str | None:
        """Return the description of the application's failure, if any."""
        return self._exit_error

    def set_exit_reason(self, reason: pk.ExitReason):
        self._exit_reason = reason

    def get_exit_reason(self) -> pk.ExitReason | None:
        """Return how the process finished, or None if it hasn't."""
        return self._exit_reason

    def is_finished(self) -> bool:
        """Return True if the process has finished: a ZOMBIE, or LOST."""
        return self._status in (KernelProcessStatus.ZOMBIE, KernelProcessStatus.LOST)

    # Kill requests

    def add_kill_request(self, requester: "KernelProcessState | None", request_id: int):
        """Record a request to kill this process, to be answered on exit.

        :param requester: Process to answer, or None for the p-kernel's
                          own kill (at shutdown)."""
        self._kill_requests.append((requester, request_id))

    def take_kill_requests(self) -> list[tuple["KernelProcessState | None", int]]:
        """Return and clear the pending kill requests for this process."""
        requests = self._kill_requests
        self._kill_requests = []
        return requests

    # p-call Session

    def get_buffer(self) -> pk.Buffer:
        """Return reference to the receive buffer."""
        return self._recv_buffer

    def receive_data(self, buf: bytes):
        """Process received TCP data.

        :param buf: Byte buffer of received data.

        Will append data to receive buffer, and inform kernel."""

        self._recv_buffer.append(buf)
        self._kernel.dispatch(self)
        return

    def send_data(self, data: bytes) -> int:
        """Send a message to a connected client.

        :param data: Byte buffer of data to send.
        :returns: Number of bytes sent."""

        # FIXME: append to send buffer, and write async?

        if not self._sock:
            return 0

        self._sock.sendall(data)
        logging.info(f"Sent {len(data)} bytes to socket {self._sock.getpeername()}")
        return len(data)

    def on_readable(self, sock: socket.socket):
        """Handle data available to receive."""

        try:
            recv_buf = sock.recv(65536)
        except ConnectionResetError:
            logging.warning(f"IPC: {self.name()} connection reset.")
            self._kernel.handle_disconnect(self)
            return

        if len(recv_buf) == 0:
            logging.debug(f"IPC: {self.name()} connection closed by peer.")
            self._kernel.handle_disconnect(self)
            return

        self._recv_buffer.append(recv_buf)
        logging.debug(f"IPC: {self.name()} "
                      f"delivered {len(recv_buf)} bytes")

        self._kernel.dispatch(self)
        return

    def on_writeable(self, sock: socket.socket):
        """Handle socket ready for send."""

        # FIXME: unused yet

        if len(self._send_buffer) > 0:
            sent = sock.send(self._send_buffer)
            if sent < len(self._send_buffer):
                self._send_buffer = self._send_buffer[sent:]
            else:
                self._send_buffer = b''
        return



class TemporaryReader:
    def __init__(self, kernel, sock: socket.socket):
        self._kernel = kernel
        self._sock = sock
        self._recv_buffer = pk.Buffer()

    def name(self) -> str:
        return f"sock  {self._sock.fileno()}"

    def get_buffer(self) -> pk.Buffer:
        return self._recv_buffer

    def get_socket(self) -> socket.socket:
        """Return the TCP socket connected to this client."""
        return self._sock

    def on_readable(self, sock: socket.socket):
        """Handle data available to receive."""

        try:
            recv_buf = self._sock.recv(65536)
        except ConnectionResetError:
            logging.warning(f"IPC: {self.name()} connection reset.")
            self._kernel.handle_incoming_disconnect(self)
            return

        if len(recv_buf) == 0:
            logging.debug(f"IPC: {self.name()} connection closed by peer.")
            self._kernel.handle_incoming_disconnect(self)
            return

        self._recv_buffer.append(recv_buf)
        logging.debug(f"IPC: {self.name()} "
                      f"delivered {len(recv_buf)} bytes")

        self._kernel.dispatch_incoming(self)
        return


class PseudoKernel(SocketListener, TimerListener):
    """Experimental implementation of kernel features."""

    def __init__(self):
        """Constructor."""

        # Event loop, using the callbacks model for I/O.
        self._loop = darq.SelectEventLoop()

        # Platform details for logging.
        self.host_os = ''
        self.host_os_version = ''
        self.python_version = ''
        self.cpu = ''
        self.device = ''

        # DarqOS Process IDentifier allocator.
        self._next_dpid = 1

        # Process table, keyed by dpid.
        self._process_table: dict[int,  KernelProcessState] = {}

        # Map of p-call sockets to process.
        self._processes: dict[socket.socket, KernelProcessState] = {}

        # Live ports, by internal identifier.  Processes refer to them
        # through their handle tables (see KernelProcessState).
        self._ports: dict[int, KernelPortState] = {}
        self._next_port_id: int = 1

        # Name registry: named ports, and blocking lookups waiting for a
        # name to be registered, as (process, request_id, monotonic time).
        self._names: dict[str, KernelPortState] = {}
        self._name_waiters: dict[str, list[tuple[KernelProcessState, int, float]]] = {}

        # Blocking waits for children to finish, by parent dpid: (parent,
        # request_id, child dpid or zero for any child).
        self._wait_requests: dict[int, list[tuple[KernelProcessState, int, int]]] = {}

        # Host processes of processes removed from the process table, not
        # yet reaped.
        self._unreaped: list[subprocess.Popen] = []

        # Set once shutdown has started, and whether to restart afterwards.
        self._stopping: bool = False
        self._reboot: bool = False

        # Set once shutdown is complete: no process is left running.
        self._stopped: bool = False

        # Timer to force shutdown, while it's in progress.
        self._shutdown_timer: int | None = None

        # Registries.
        self.types = []
        self.tools = []
        self.lenses = []

        # Map of accepted sockets, not yet associated with a
        # KernelProcessState (awaiting their RunRequest).
        self.incoming_connections = {}

        # Host platform.
        self.detect_platform()

        # p-call listening socket.
        self.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.socket.setblocking(False)
        self.socket.bind((TCP_HOST, TCP_PORT))
        self.socket.listen()
        self._loop.add_socket(self.socket, self)

        # Periodic warnings about slow name lookups (see on_timeout).
        self._loop.add_timer(LOOKUP_WARNING_INTERVAL, self)

        # Child process exit notification.  SIGCHLD writes a byte to this
        # socket pair, waking the event loop to reap exited children.
        self._sigchld_reader, self._sigchld_writer = socket.socketpair()
        self._sigchld_reader.setblocking(False)
        self._sigchld_writer.setblocking(False)
        signal.signal(signal.SIGCHLD, lambda signum, frame: None)
        signal.set_wakeup_fd(self._sigchld_writer.fileno())
        self._loop.add_socket(self._sigchld_reader, self)

        # Log platform details for debugging.
        logging.info(f"Using {self.host_os} {self.host_os_version}")
        logging.info(f"On a {self.device} ({self.cpu})")
        logging.info(f"Running Python v{self.python_version}")
        logging.info("")
        logging.info(f"Listening for IPC sessions on {TCP_HOST}:{TCP_PORT}")

        # Complete.
        logging.info("Initialized.")
        return

    @staticmethod
    def get_name() -> str:
        return "p-kernel"

    def close(self):
        """Release the p-call sockets, child exit notification, and event loop."""
        signal.set_wakeup_fd(-1)
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        self._sigchld_reader.close()
        self._sigchld_writer.close()
        self.socket.close()

        # Sessions still open, identified or not.
        for sock in list(self._processes) + list(self.incoming_connections):
            sock.close()
        self._processes.clear()
        self.incoming_connections.clear()

        self._loop.close()
        return

    def on_readable(self, sock: socket.socket):
        """Handle client offer socket readable event."""
        if sock is self._sigchld_reader:
            try:
                while self._sigchld_reader.recv(4096):
                    pass
            except BlockingIOError:
                pass
            self.reap_children()
            return

        if sock == self.socket:
            client_socket, client_addr = self.socket.accept()
            self.incoming_connections[client_socket] = TemporaryReader(kernel=self, sock=client_socket)
            self._loop.add_socket(client_socket, self)
            logging.info(f"Socket [{client_socket.fileno()}] "
                         f"connected from {client_addr}")
            return

        incoming_connection = self.incoming_connections.get(sock)
        if incoming_connection:
            incoming_connection.on_readable(sock)
            return

        client = self._processes.get(sock)
        if client:
            client.on_readable(sock)
            return

        logging.warning(f"Socket [{sock.fileno()}] readable but unrecognized.")
        return

    def on_writeable(self, sock: socket.socket):
        # Ignore writeable events on offer socket.
        pass

    def on_timeout(self, timer_id: int, expiry_time: float, actual_time: float):
        """Periodic timer: warn about slow name lookups."""
        self.warn_slow_lookups(actual_time)

    def warn_slow_lookups(self, now: float):
        """Log a warning for each blocking lookup waiting longer than the interval.

        :param now: Current time.monotonic() value."""
        for name, waiters in self._name_waiters.items():
            for process, _, since in waiters:
                if now - since >= LOOKUP_WARNING_INTERVAL:
                    logging.warning(f"{process.name()} lookup_name({name!r}) "
                                    f"still waiting after {now - since:.0f}s")
        return

    def after(self, seconds: float, function):
        """Call function once, after a delay."""
        self._loop.add_timer(seconds, darq.DeferredListener(self._loop, function))
        return

    def run(self):
        """Main loop."""

        logging.info("Entering main loop.")
        while not self._stopped:
            try:
                self._loop.run()
                return
            except KeyboardInterrupt:
                # Shut down cleanly, running the loop until it's done
                # (unless there was nothing to wait for).
                self.begin_shutdown(reboot=False)

    def handle_disconnect(self, process: KernelProcessState):
        """Handle disconnection of a client process.

        :param process: Client that has disconnected."""

        # Cache name, because we need to use it a few times.
        name = process.name()

        # Answer anyone waiting for this process to be killed.
        kill_requests = process.take_kill_requests()
        for requester, request_id in kill_requests:
            if requester is not None and requester is not process:
                self.send_kill_process_response(requester, request_id, 0)

        # A process that reported its exit, or was killed, is a zombie until
        # its parent collects it; otherwise, it was lost.
        if process.has_exited():
            process.set_status(KernelProcessStatus.ZOMBIE)
            process.set_exit_reason(pk.ExitReason.EXITED)
        elif kill_requests:
            process.set_status(KernelProcessStatus.ZOMBIE)
            process.set_exit_reason(pk.ExitReason.KILLED)
        else:
            process.set_status(KernelProcessStatus.LOST)
            process.set_exit_reason(pk.ExitReason.LOST)

        # Abandon its lookups and waits, and release its rights, destroying
        # the ports it owns.
        for waited_name in list(self._name_waiters):
            waiters = [w for w in self._name_waiters[waited_name] if w[0] is not process]
            if waiters:
                self._name_waiters[waited_name] = waiters
            else:
                del self._name_waiters[waited_name]
        self._wait_requests.pop(process.get_dpid(), None)

        for entry in process.take_handles():
            if entry.right == PortRight.RECEIVE:
                self.destroy_port(entry.port)
                logging.debug(f"{name} closed {entry.port}")

        # Remove client.
        sock = process.get_socket()
        if sock:
            if sock in self._processes:
                del self._processes[sock]

            self._loop.cancel_socket(sock)
            sock.close()

        process.set_socket(None)

        logging.info(f"{name} disconnected.")
        self.process_finished(process)
        return

    def handle_exited(self, process: KernelProcessState, message: pk.Exited):
        """Record a process' report that its application has finished.

        The process then closes its p-call session, which makes it a
        zombie (see handle_disconnect)."""
        if process.has_exited():
            logging.warning(f"{process.name()} reported its exit again")

        error = message.get_error()
        process.set_exit(message.status, error)
        logging.info(f"{process.name()} exited with status {message.status}"
                     + (f": {error}" if error else ""))
        return

    def handle_incoming_disconnect(self, reader: TemporaryReader):
        """Close a connection that hasn't (successfully) sent RUN_REQUEST.

        :param reader: Handler for the unidentified connection."""
        sock = reader.get_socket()
        logging.info(f"{reader.name()} disconnected before running.")

        self.incoming_connections.pop(sock, None)
        self._loop.cancel_socket(sock)
        sock.close()
        return

    def create_port(self, owner: KernelProcessState) -> KernelPortState:
        """Create a port, owned by a process.

        :param owner: Process to hold its receive right.
        :returns: The new port."""
        port = KernelPortState(self._next_port_id, owner)
        self._next_port_id += 1
        self._ports[port.port_id] = port
        return port

    def destroy_port(self, port: KernelPortState):
        """Destroy a port: handles other processes hold for it become dead.

        Its name, if any, is removed from the registry."""
        port.alive = False
        port.owner = None
        self._ports.pop(port.port_id, None)

        if port.name is not None:
            logging.info(f"Name '{port.name}' removed with {port}")
            self._names.pop(port.name, None)
            port.name = None
        return

    @staticmethod
    def is_reserved_name(name: str) -> bool:
        """Return True if a name is reserved for system services."""
        return name == "darq" or name.startswith("darq.")

    @staticmethod
    def decode_name(message: pk.RegisterNameRequest | pk.LookupNameRequest) -> str | None:
        """Return a request's name, or None if it's not a valid name."""
        if not 0 < len(message.name) <= pk.MAX_NAME_LENGTH:
            return None
        try:
            return message.get_name()
        except UnicodeDecodeError:
            return None

    def handle_reboot(self, process: KernelProcessState, message: pk.Reboot):
        if self.may_shut_down(process, "reboot"):
            self.begin_shutdown(reboot=True)

    def handle_shutdown(self, process: KernelProcessState, message: pk.Shutdown):
        if self.may_shut_down(process, "shutdown"):
            self.begin_shutdown(reboot=False)

    @staticmethod
    def may_shut_down(process: KernelProcessState, action: str) -> bool:
        """Return True if a process may shut down or reboot the system.

        Only processes the p-kernel spawned itself (parent dpid 0) may.
        There's no response to the request, so a refusal is only logged."""
        if process.get_parent_dpid() != 0:
            logging.warning(f"{process.name()} {action} refused: not a system process")
            return False

        logging.info(f"{process.name()} requested {action}.")
        return True

    def begin_shutdown(self, reboot: bool):
        """Kill every process, then leave the event loop.

        Running processes are asked to exit, as by kill_process, and
        spawned ones not yet running have their host processes killed.
        Any still running after SHUTDOWN_TIMEOUT have their host processes
        killed too.  Once none are left, the event loop stops: the caller
        of run() then exits, or restarts the p-kernel (see restart()).

        :param reboot: If True, restart the p-kernel afterwards."""
        if self._stopping:
            return
        self._stopping = True
        self._reboot = reboot
        logging.info(f"Starting {'reboot' if reboot else 'shutdown'}.")

        for process in list(self._process_table.values()):
            status = process.get_status()
            if status == KernelProcessStatus.RUNNING:
                process.add_kill_request(None, 0)
                process.send_data(pk.KillProcessRequest(0, process.get_dpid()).encode())
            elif status == KernelProcessStatus.SPAWNED:
                self.kill_host_process(process)

        self._shutdown_timer = self._loop.add_timer(
            SHUTDOWN_TIMEOUT, darq.DeferredListener(self._loop, self.force_shutdown))
        self.check_shutdown()
        return

    @staticmethod
    def kill_host_process(process: KernelProcessState):
        """Kill a process' host (Linux) process, if it's still running."""
        child = process.get_child()
        if child is not None and child.poll() is None:
            logging.warning(f"{process.name()} killing host process [{child.pid}]")
            child.kill()
        return

    def force_shutdown(self):
        """Kill the host processes of processes still running at shutdown."""
        for process in list(self._process_table.values()):
            if process.get_status() in (KernelProcessStatus.RUNNING, KernelProcessStatus.SPAWNED):
                logging.error(f"{process.name()} didn't exit at shutdown")
                if process.get_child() is not None:
                    self.kill_host_process(process)
                elif process.get_status() == KernelProcessStatus.RUNNING:
                    # Nothing to kill: just end its session.
                    self.handle_disconnect(process)
        self.check_shutdown()
        return

    def check_shutdown(self):
        """Finish shutting down, once no process is running or spawned."""
        if not self._stopping:
            return

        for process in self._process_table.values():
            if process.get_status() in (KernelProcessStatus.RUNNING, KernelProcessStatus.SPAWNED):
                return

        if not self._stopped:
            logging.info("All processes have exited.")
            self._stopped = True
            if self._shutdown_timer is not None:
                self._loop.cancel_timer(self._shutdown_timer)
                self._shutdown_timer = None
        self._loop.stop()
        return

    def reboot_requested(self) -> bool:
        """Return True if the p-kernel should restart after its event loop ends."""
        return self._reboot

    def restart(self):
        """Replace this process with a new p-kernel.

        The process is replaced (with exec), not left to exit after
        starting another, so a service manager (systemd) sees the same
        process continue.  All sockets are close-on-exec."""
        logging.info("Restarting p-kernel.")
        self.close()
        logging.shutdown()
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])

