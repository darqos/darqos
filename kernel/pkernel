    @staticmethod
    def next_message(buffer: pk.Buffer) -> tuple[int, bytes] | None:
        """Take the next complete message from a receive buffer.

        :param buffer: Receive buffer.
        :returns: (message type, message bytes), or None if incomplete.
        :raises MessageDecodingError: if the header is invalid."""

        # See if we have a header yet.
        if buffer.length() < 8:
            return None

        message_type = pk.Message.decode_type(buffer.peek(8))
        message_length = pk.Message.decode_length(buffer.peek(8))

        if message_length < 8:
            raise darq.MessageDecodingError(f"invalid message length {message_length}")

        if message_length > buffer.length():
            # Wait for the rest of the message.
            return None

        message_bytes = buffer.peek(message_length)
        buffer.consume(message_length)  # FIXME: merge these two!
        return message_type, message_bytes

    def dispatch_incoming(self, reader: TemporaryReader):
        """Process data received on a connection not yet identified.

        The first message must be RUN_REQUEST: anything else drops the
        connection."""

        try:
            next_message = self.next_message(reader.get_buffer())
            if next_message is None:
                return

            message_type, message_bytes = next_message
            if message_type != pk.MessageType.RUN_REQUEST:
                logging.error(f"{reader.name()} sent message type "
                              f"[{message_type}] before RUN_REQUEST")
                self.handle_incoming_disconnect(reader)
                return

            message = pk.RunRequest()
            message.decode(message_bytes)
        except darq.MessageDecodingError as e:
            logging.error(f"{reader.name()} invalid message: {e}")
            self.handle_incoming_disconnect(reader)
            return

        self.handle_run_request(reader, message)
        return

    def dispatch(self, process: KernelProcessState):
        """Process data received from clients.

        :param process: Client connection that received data

        Handle every complete message in the receive buffer."""

        while process.get_socket() is not None:
            try:
                next_message = self.next_message(process.get_buffer())
                if next_message is None:
                    return
                message_type, message_bytes = next_message
                self.dispatch_message(process, message_type, message_bytes)
            except darq.MessageDecodingError as e:
                logging.error(f"{process.name()} invalid message: {e}")
                self.handle_disconnect(process)
                return
        return

    def dispatch_message(self,
                         process: KernelProcessState,
                         message_type: int,
                         message_bytes: bytes):
        """Decode one message from a client, and call its handler."""

        if message_type == pk.MessageType.OPEN_PORT_RQST:
            message = pk.OpenPortRequest()
            message.decode(message_bytes)
            self.handle_open_port_request(process, message)

        elif message_type == pk.MessageType.CLOSE_PORT_RQST:
            message = pk.ClosePortRequest()
            message.decode(message_bytes)
            self.handle_close_port_request(process, message)

        elif message_type == pk.MessageType.SEND_MESSAGE_RQST:
            message = pk.SendMessageRequest()
            message.decode(message_bytes)
            self.handle_send_message_request(process, message)

        elif message_type == pk.MessageType.SPAWN_PROCESS_RQST:
            message = pk.SpawnProcessRequest(0, "")
            message.decode(message_bytes)
            self.handle_spawn_process(process, message)

        elif message_type == pk.MessageType.REGISTER_NAME_RQST:
            message = pk.RegisterNameRequest()
            message.decode(message_bytes)
            self.handle_register_name_request(process, message)

        elif message_type == pk.MessageType.LOOKUP_NAME_RQST:
            message = pk.LookupNameRequest()
            message.decode(message_bytes)
            self.handle_lookup_name_request(process, message)

        elif message_type == pk.MessageType.WAIT_RQST:
            message = pk.WaitRequest()
            message.decode(message_bytes)
            self.handle_wait_request(process, message)

        elif message_type == pk.MessageType.KILL_PROCESS_RQST:
            message = pk.KillProcessRequest()
            message.decode(message_bytes)
            self.handle_kill_process_request(process, message)

        elif message_type == pk.MessageType.EXITED:
            message = pk.Exited()
            message.decode(message_bytes)
            self.handle_exited(process, message)

        elif message_type == pk.MessageType.REBOOT:
            message = pk.Reboot()
            message.decode(message_bytes)
            self.handle_reboot(process, message)

        elif message_type == pk.MessageType.SHUTDOWN:
            message = pk.Shutdown()
            message.decode(message_bytes)
            self.handle_shutdown(process, message)

        else:
            logging.warning(f"{process.name()} Received message with "
                            f"unexpected type code [{message_type}] "
                            "Ignoring message.")
        return

    def detect_platform(self):
        """Detect host platform."""

        # Host OS (macOS, Linux, Darq)
        system = platform.system()
        if system == 'Darwin':
            self.host_os = 'macOS'
        elif system == 'Linux':
            self.host_os = 'Linux'
        else:
            self.host_os = 'Unknown'

        # OS Version
        if system == 'Darwin':
            mac_ver = platform.mac_ver()
            self.host_os_version = mac_ver[0]
        elif system == 'Linux':
            linux_ver = platform.freedesktop_os_release()
            self.host_os_version = linux_ver['PRETTY_NAME']
        else:
            self.host_os_version = 'Unknown'

        # CPU architecture.
        mach = platform.machine()
        if system == 'Darwin':
            self.cpu = mach
        elif system == 'Linux':
            self.cpu = mach
        else:
            self.cpu = 'Unknown'

        # Python version.
        self.python_version = platform.python_version()

        # Hardware device.
        if system == 'Darwin':
            f = os.popen("system_profiler SPHardwareDataType")
            s = f.read()
            f.close()

            model_name = 'Unknown'
            model_id = 'Unknown'

            for line in s.split('\n'):
                if ':' not in line:
                    continue

                key, value = line.split(':', 1)
                key = key.strip()
                value = value.strip()

                if key == 'Model Name':
                    model_name = value
                elif key == 'Model Identifier':
                    model_id = value

            # FIXME: needs the "MacBook Pro Retina (late 2014)" here.
            self.device = f"{model_name} ({model_id})"

        if system == 'Linux':
            # FIXME: otherwise, dmidecode has some info?

            f = open('/proc/cpuinfo')
            s = f.read()
            f.close()

            model_name = 'Unknown'

            for line in s.split('\n'):
                if ':' not in line:
                    continue

                key, value = line.split(':', 1)
                key = key.strip()
                value = value.strip()

                if key == 'Model':
                    model_name = value

            self.device = f"{model_name}"

        return

