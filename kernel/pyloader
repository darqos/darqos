# This is the DarqOS loader for Python executables.  It is responsible for:
# - Establishing the control session with the p-kernel
# - Passing p-call requests/messages to the p-kernel
# - Delivering p-call responses to the application
# - Executing the application code
# - Reporting the application's exit status to the p-kernel
#
# There are two threads.  The main thread runs the application: it
# loads main.py from the specified executable, and calls its darq_main()
# function.  The application owns the main thread, so it can use GUI
# toolkits (such as Qt) that require it, and receive signals.
#
# The second (I/O) thread runs an event loop servicing the socket
# connection to the p-kernel.  It sends the application's p-calls, and
# delivers their responses: synchronous p-calls are woken directly,
# while callbacks and delivered messages are posted to the application's
# event loop (see darq.init() and darq.init_cb()).

import ctypes
import enum
import importlib
import logging
import os
import queue
import setproctitle
import socket
import sys
import threading
import traceback

import darq
from darq import pcall as pk


class AppState(enum.Enum):
    """Progress of the application on the main thread."""

    # Waiting for the p-kernel's RUN_RESPONSE.
    PENDING = 1

    # Loading, or running, darq_main().
    RUNNING = 2

    # Finished, killed, or never to be started.
    FINISHED = 3


class PythonPProcess(darq.SocketListener):
    def __init__(self, pkernel_port: int, dpid: int, parent_dpid: int, exec_path: str):
        logging.info(f"Darq PID [{dpid}], parent [{parent_dpid}], host PID [{os.getpid()}] from [{exec_path}]")

        self._pkernel_port = pkernel_port
        self._dpid = dpid
        self._parent_dpid = parent_dpid
        self._exec_path = exec_path

        # Set host process title to assist with debugging.
        setproctitle.setproctitle(f"darq-{self._dpid}")

        # Connection to p-Kernel process.
        self._pkernel_sock: socket.socket | None = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

        # p-Call request queue from the application (queue is thread-safe).
        self._requests = queue.Queue()

        # p-Calls sent to the p-kernel and awaiting a response, by request_id.
        # Only accessed from the I/O thread.
        self._pending: dict[int, darq.SystemCallState] = {}

        # Open ports, by port number.
        self.ports: dict[int, darq.PortState] = {}

        # The application's event loop, set by darq.init(), and its
        # listener, set by darq.init_cb().  Callbacks are posted to it.
        self.loop: darq.EventLoopInterface | None = None
        self.listener: darq.EventListener | None = None

        # The application's progress, guarded by the lock: it's changed
        # by both threads.  The main thread waits for the start event
        # before running the application, and the I/O thread waits for
        # the finished event when killing it.
        self._app_lock = threading.Lock()
        self._app_state = AppState.PENDING
        self._app_start = threading.Event()
        self._app_finished = threading.Event()

        # Thread identifier of the main thread, while it runs the application.
        self._app_ident: int | None = None

        # Set once the RUN_RESPONSE has been handled.  Only accessed
        # from the I/O thread.
        self._run_decided: bool = False

        # The application's result: (status, error), set when it finishes.
        self._app_result: tuple[int, str | None] | None = None

        # Set when the application is being killed, rather than finishing
        # by itself.
        self._app_killed: bool = False

        # Exit status requested by darq.exit(), if it was called.
        self._exit_requested: int | None = None

        # Set once the application's exit has been reported, and the
        # p-call session is closing.
        self._exiting: bool = False

        # Transaction identifiers for p-kernel requests.  Only accessed from
        # the I/O thread.
        self.request_id: int = 0

        # Re-assembly buffer.
        self.recv_buffer = pk.Buffer()

        # Thread running the I/O event loop.
        self._io_thread: threading.Thread | None = None

        # Host process exit status.
        self.exit_status: int = 0

        # I/O event loop.
        self.io_loop = darq.SelectEventLoop()
        return

    def getpid(self) -> int:
        """Return the DarqOS process identifier for this p-process."""
        return self._dpid

    def getppid(self) -> int:
        """Return the DarqOS process identifier for the parent of this p-process."""
        return self._parent_dpid

    def get_next_request_id(self) -> int:
        """Return the next unused request identifier for this p-process.

        """
        self.request_id += 1
        return self.request_id

    def queue_new_syscall(self, syscall_state: darq.SystemCallState):
        """Queue a system call to be sent to the p-kernel."""
        self._requests.put(syscall_state)
        self.io_loop.post(self.handle_syscall_queue)
        return

    def handle_syscall_queue(self):
        """Send queued p-calls from the application to the p-kernel."""

        while True:
            try:
                syscall = self._requests.get_nowait()
            except queue.Empty:
                return

            # Requests with a request_id expect a response: assign the
            # identifier, and record them before sending, so the response
            # can be matched.
            request = syscall.get_request()
            if hasattr(request, "request_id"):
                request.request_id = self.get_next_request_id()
                self._pending[request.request_id] = syscall

            self.send_to_p_kernel(request)

    def complete_syscall(self, response) -> darq.SystemCallState | None:
        """Match a p-kernel response to its pending p-call, and complete it.

        :param response: Decoded response message, with a request_id.
        :returns: The completed p-call state, or None if unknown."""

        syscall = self._pending.pop(response.request_id, None)
        if syscall is None:
            logging.warning(f"Response to unknown request {response.request_id}")
            return None

        syscall.set_response(response)

        mode = syscall.get_mode()
        if mode == darq.SystemCallMode.SYNC:
            syscall.notify()
        elif mode == darq.SystemCallMode.CALLBACK:
            self.post_callback(syscall)
        else:
            logging.warning(f"Mode {mode} completion not implemented")
        return syscall

    @staticmethod
    def callback_args(syscall: darq.SystemCallState) -> tuple[int, int]:
        """Return a completed p-call's callback arguments: (value, error_code).

        The value is the port, or process, the p-call was about."""
        response = syscall.get_response()
        if isinstance(response, (pk.OpenPortResponse, pk.ClosePortResponse)):
            return response.port, response.result
        if isinstance(response, pk.SpawnProcessResponse):
            return response.dpid, response.result
        if isinstance(response, pk.KillProcessResponse):
            request = syscall.get_request()
            assert isinstance(request, pk.KillProcessRequest)
            return request.dpid, response.result
        if isinstance(response, pk.RegisterNameResponse):
            request = syscall.get_request()
            assert isinstance(request, pk.RegisterNameRequest)
            return request.port, response.result
        if isinstance(response, pk.LookupNameResponse):
            return response.port, response.result
        raise TypeError(f"No callback arguments for {type(response).__name__}")

    def post_callback(self, syscall: darq.SystemCallState):
        """Call a completed p-call's callback on its event loop."""
        loop, callback = syscall.get_callback()
        if loop is None or callback is None:
            logging.warning("Callback p-call completed without a callback")
            return

        args = self.callback_args(syscall)
        try:
            loop.post(lambda: callback(*args))
        except RuntimeError:
            logging.warning("Callback dropped: its event loop is closed")
        return

    def post_to_app(self, function):
        """Call function on the application's event loop.

        :returns: False if the application has no event loop, or it's
                  closed."""
        if self.loop is None:
            return False
        try:
            self.loop.post(function)
        except RuntimeError:
            logging.warning("Event dropped: the application's event loop is closed")
            return False
        return True

    def run_app(self):
        """Load and run the application, and report how it ended.

        Runs on the main thread, once the p-kernel has accepted this
        process.  A return value of None or 0, or sys.exit() with no
        code, is success; an integer is the exit status; anything else,
        including an exception, is status 1, with a description of the
        failure.  A failure to load the application is reported the same
        way."""

        with self._app_lock:
            if self._app_state != AppState.PENDING:
                return
            self._app_state = AppState.RUNNING
            self._app_ident = threading.get_ident()

        error = None
        try:
            try:
                darq_main = self.load_app()
                result = darq_main()
            finally:
                self.app_finished()
            status, error = self.status_from_result(result, "darq_main returned")
        except SystemExit as e:
            if self._app_killed:
                logging.debug("Application killed.")
                return
            if self._exit_requested is not None:
                status, error = self._exit_requested, None
            else:
                status, error = self.status_from_result(e.code, "sys.exit() with")
        except BaseException:
            status, error = 1, traceback.format_exc()

        self.app_exited(status, error)
        return

    def load_app(self):
        """Import the application's main module, and return its darq_main."""

        # Add executable module's location to system path.
        sys.path.insert(0, self._exec_path)

        # Inject the process state structure into the darq.system module, so
        # the application can make p-calls (even while being imported).
        darq.system.__dict__["_darq_process_state"] = self

        main = importlib.import_module("main")
        return main.darq_main

    def exit(self, status: int):
        """End the application, with an exit status: see darq.exit().

        Called on any of the application's threads.  On the main thread,
        it raises SystemExit; on another, it raises SystemExit in the main
        thread (waking any p-call it's blocked in), and in this one."""
        if not isinstance(status, int) or not -2 ** 31 <= status < 2 ** 31:
            raise ValueError(f"exit status must be a 32 bit signed integer: {status!r}")

        with self._app_lock:
            self._exit_requested = int(status)
            if self._app_state == AppState.RUNNING and threading.get_ident() != self._app_ident:
                assert self._app_ident is not None  # set while running
                ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(self._app_ident),
                                                           ctypes.py_object(SystemExit))
                self.io_loop.post(self.wake_app)
        raise SystemExit(status)

    def wake_app(self):
        """Wake any p-call the application is blocked in.

        Called on the I/O thread, so the blocked call can see an exception
        raised in its thread (by kill_app or exit)."""
        while True:
            try:
                self._requests.get_nowait().notify()
            except queue.Empty:
                break

        for syscall in self._pending.values():
            syscall.notify()
        self._pending.clear()

        # And any receive_message() it's blocked in.
        for port_state in list(self.ports.values()):
            port_state.wake()
        return

    def app_finished(self):
        """Record that the application code is no longer running.

        Called on the main thread.  Once this returns, the application
        can no longer be killed."""
        with self._app_lock:
            self._app_state = AppState.FINISHED
            self._app_ident = None
            self._app_finished.set()
        return

    @staticmethod
    def status_from_result(value, description: str) -> tuple[int, str | None]:
        """Convert an application's result into (status, error).

        :param value: darq_main's return value, or sys.exit()'s code.
        :param description: How the value was given, for the error."""
        if value is None:
            return 0, None
        if isinstance(value, int) and -2 ** 31 <= value < 2 ** 31:
            return int(value), None
        return 1, f"{description} {value!r}"

    def app_exited(self, status: int, error: str | None):
        """Record the application's result, and have the I/O thread report it.

        Called on the main thread."""
        self._app_result = (status, error)
        self.io_loop.post(self.handle_app_exit)
        return

    def handle_app_exit(self):
        """Report the application's exit to the p-kernel, and close the session."""

        if self._app_result is None or self._exiting:
            return

        status, error = self._app_result
        if status == 0:
            logging.info("Application exited.")
        else:
            logging.info(f"Application exited with status {status}.")
        if error:
            logging.error(f"Application failed: {error}")
        self.exit_status = status if 0 <= status <= 255 else 1

        # Send any p-calls the application made before it finished first.
        self.handle_syscall_queue()
        self.send_to_p_kernel(pk.Exited(status, error))

        if self._pkernel_sock is None:
            self._end_app()
            return

        # Close the sending side, so the p-kernel reads Exited and then EOF.
        # The socket is closed once the p-kernel closes its side: closing it
        # with data unread would reset the connection.
        self._exiting = True
        try:
            self._pkernel_sock.shutdown(socket.SHUT_WR)
        except OSError:
            # Already disconnected: there's nothing more to wait for.
            self.handle_p_kernel_close()
        return

    def handle_p_kernel_close(self):
        """Finish closing the p-call session, after the application exited."""
        logging.debug("p-kernel closed the session.")
        self.close_p_kernel_socket()
        self._end_app()
        return

    def close_p_kernel_socket(self):
        """Stop monitoring, and close, the p-call session's socket."""
        sock = self._pkernel_sock
        if sock is None:
            return

        self.io_loop.cancel_socket(sock)
        sock.close()
        self._pkernel_sock = None
        return

    def connect_to_p_kernel(self):
        """Establish the TCP connection to the p-kernel."""

        sock = self._pkernel_sock
        assert sock is not None, "already disconnected"
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.io_loop.add_socket(sock, self)
        sock.connect(('127.0.0.1', self._pkernel_port))
        return

    def on_readable(self, sock: socket.socket):
        logging.debug("Callback: socket is readable")

        try:
            data = sock.recv(65536)
        except ConnectionResetError:
            data = b''

        if not data:
            if self._exiting:
                self.handle_p_kernel_close()
            else:
                self.handle_p_kernel_disconnect()
            return

        self.handle_bytes_from_p_kernel(data)

    def handle_p_kernel_disconnect(self):
        """Handle the p-kernel closing the p-call session.

        Without the p-kernel, this process can't continue: kill the
        application and exit."""
        logging.error("Disconnected by p-kernel: exiting.")
        self.exit_status = 1

        self.close_p_kernel_socket()

        self.kill_app()
        self._end_app()
        return

    def on_writeable(self, sock: socket.socket):
        #logging.debug("Callback: socket is writeable")
        pass

    def on_connected(self, sock: socket.socket):
        logging.debug("Callback: socket is connected")
        pass

    def send_to_p_kernel(self, message: pk.Message):
        """Send a "syscall" message to the p-Kernel.

        :param message: Message to send."""
        if self._pkernel_sock is None:
            logging.warning(f"Not connected to p-kernel: message type {message.type} dropped")
            return

        buffer = message.encode()

        # FIXME: in an async world, this should queue and return if it can't
        # write immediately
        self._pkernel_sock.sendall(buffer)
        return

    def handle_bytes_from_p_kernel(self, buffer: bytes):

        # Append bytes to process-wide reassembly buffer.
        self.recv_buffer.append(buffer)

        while True:
            # Attempt to get message: if message is incomplete, just return.
            if self.recv_buffer.length() < 8:
                return

            header_buf = self.recv_buffer.peek(8)  # FIXME: check version, etc, first.
            message_length = pk.Message.decode_length(header_buf)
            if message_length < 8:
                # The stream can't be split into messages any more: treat
                # it like the p-kernel closing the session.
                logging.error(f"Invalid message length {message_length} from p-kernel.")
                self.handle_p_kernel_disconnect()
                return

            if self.recv_buffer.length() < message_length:
                # Wait for more data to be delivered so we can decode message.
                return

            message_buf = self.recv_buffer.peek(message_length)
            self.recv_buffer.consume(message_length)  # FIXME: make this one operation
            message_type = pk.Message.decode_type(message_buf)

            self.dispatch(message_type, message_buf)

    def dispatch(self, message_type, message_buf):
        if message_type == pk.MessageType.DELIVER_MESSAGE:
            message = pk.DeliverMessage()
            message.decode(message_buf)
            self.handle_deliver_message(message)

        elif message_type == pk.MessageType.OPEN_PORT_RESP:
            message = pk.OpenPortResponse()
            message.decode(message_buf)
            self.handle_open_port_response(message)

        elif message_type == pk.MessageType.CLOSE_PORT_RESP:
            message = pk.ClosePortResponse()
            message.decode(message_buf)
            self.handle_close_port_response(message)

        elif message_type == pk.MessageType.SPAWN_PROCESS_RESP:
            message = pk.SpawnProcessResponse(0, 0, 0, None)
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.SEND_MESSAGE_RESP:
            message = pk.SendMessageResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.WAIT_RESP:
            message = pk.WaitResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.REGISTER_NAME_RESP:
            message = pk.RegisterNameResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.LOOKUP_NAME_RESP:
            message = pk.LookupNameResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.GET_BOOT_VALUE_RESP:
            message = pk.GetBootValueResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.SET_BOOT_VALUE_RESP:
            message = pk.SetBootValueResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == pk.MessageType.RUN_RESPONSE:
            message = pk.RunResponse()
            message.decode(message_buf)
            self.handle_run_response(message)

        elif message_type == pk.MessageType.KILL_PROCESS_RQST:
            message = pk.KillProcessRequest()
            message.decode(message_buf)
            self.handle_kill_process_request(message)

        elif message_type == pk.MessageType.KILL_PROCESS_RESP:
            message = pk.KillProcessResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        else:
            logging.warning(f"Unhandled message type: {message_type}")

    def disconnect(self):

        # Close socket (and flush buffers).
        if self._pkernel_sock is not None:
            self._pkernel_sock.close()
            self._pkernel_sock = None

    def send_run_request(self):
        """Ask the p-kernel to let this process run.

        The application is started once the p-kernel accepts: see
        handle_run_response()."""
        message = pk.RunRequest()
        message.dpid = self._dpid
        message.host_pid = os.getpid()
        self.send_to_p_kernel(message)
        return

    def handle_run_response(self, message: pk.RunResponse):
        """Start the application, if the p-kernel has accepted this process."""
        if self._run_decided:
            logging.warning("Duplicate RUN_RESPONSE ignored")
            return
        self._run_decided = True

        if message.result != 0:
            logging.error(f"p-kernel refused to run this process (result {message.result}): exiting.")
            self.exit_status = 1
            self.kill_app()
            self._end_app()
            return

        # Release the main thread to run the application.
        self._app_start.set()
        return

    def handle_deliver_message(self, message: pk.DeliverMessage):
        """Pass a delivered message to the application.

        With the callback model (see darq.init_cb), it goes to the
        listener, on the application's loop; otherwise, it's queued on
        its port for receive_message()."""
        source, destination, payload = message.source, message.destination, message.payload
        handles = message.handles
        port = self.ports.get(destination)

        listener = self.listener
        if listener is not None and self.loop is not None:
            if port is None:
                self.post_to_app(lambda: listener.on_error(0, 0, "Bad port"))
            else:
                self.post_to_app(lambda: listener.on_message(source, destination, payload))
            return

        if port is None:
            logging.warning(f"Message for port {destination} dropped: port not open")
            return

        port.deliver(source, payload, handles)
        return

    def receive_message(self, port: int, blocking: bool,
                        timeout: float | None) -> tuple[int, bytes, tuple[int, ...]] | None:
        """Receive a message delivered to a port: see darq.receive_message().

        Called on the application's thread."""
        port_state = self.ports.get(port)
        if port_state is None:
            raise darq.NonExistentPortError(port)
        return port_state.receive(blocking, timeout)


    def handle_open_port_response(self, message: pk.OpenPortResponse):
        # Record the newly-opened port before completing the p-call, so
        # the application can use it as soon as open_port() returns.
        if message.request_id in self._pending and message.result == 0:
            port_state = darq.PortState(message.port)
            port_state.is_open = True
            self.ports[message.port] = port_state

        self.complete_syscall(message)
        return

    def handle_close_port_response(self, message: pk.ClosePortResponse):
        # Forget the port before completing the p-call, releasing any
        # receiver blocked on it.
        if message.request_id in self._pending:
            port_state = self.ports.pop(message.port, None)
            if port_state is not None:
                port_state.close()

        self.complete_syscall(message)
        return

    def handle_kill_process_request(self, message: pk.KillProcessRequest):
        """Handle the p-kernel's request to kill this process."""
        if message.dpid != self._dpid:
            logging.warning(f"Kill request for DPID [{message.dpid}] ignored")
            return

        logging.info("Killed by p-kernel.")
        self.kill_app()
        self._end_app()
        return

    def kill_app(self, timeout: float = 1.0) -> bool:
        """Kill the application, or stop it from starting.

        Called on the I/O thread.

        :param timeout: Seconds to wait for the application to stop.
        :returns: True if the application isn't running."""

        with self._app_lock:
            if self._app_state == AppState.PENDING:
                # Not started yet: release the main thread, without
                # running the application.
                self._app_state = AppState.FINISHED
                self._app_finished.set()
                self._app_start.set()
                return True

            if self._app_state == AppState.FINISHED:
                return True

            # Raise SystemExit in the main thread.  Python delivers it
            # when the thread next executes bytecode, so it won't
            # interrupt a thread blocked in native code (such as a Qt
            # event loop with no events to deliver).  This is done holding
            # the lock, so the application can't finish first.
            self._app_killed = True
            assert self._app_ident is not None  # set while running
            ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(self._app_ident),
                                                       ctypes.py_object(SystemExit))

        # Wake any p-calls the application is blocked on, so it sees the
        # exception.
        self.wake_app()
        return self._app_finished.wait(timeout)

    def _end_app(self):
        """End this process, once the application has stopped."""

        # FIXME: confirm death to p-kernel.

        if not self._app_finished.is_set():
            # Stuck in native code: the interpreter can't exit while it runs.
            logging.error("Application did not exit: exiting forcibly.")
            os._exit(1)

        # Leave the I/O event loop: the I/O thread then disconnects, and
        # the main thread exits.
        self.io_loop.stop()
        return

    def run_io_loop(self):
        """Handle p-kernel messages and p-calls, until the session ends.

        Runs on the I/O thread."""
        try:
            self.io_loop.run()
        except BaseException:
            logging.exception("p-kernel I/O failed: exiting.")
            self.exit_status = 1
        finally:
            self.disconnect()

            # Don't leave the application running, or the main thread
            # waiting to start it, without the p-kernel.
            if not self.kill_app():
                logging.error("Application did not exit: exiting forcibly.")
                os._exit(1)
        return

    def run(self):
        """Run the I/O thread, and the application on this (main) thread.

        Returns once the application has finished, and the p-call session
        is closed."""

        self._io_thread = threading.Thread(target=self.run_io_loop, name="p-kernel-io")
        self._io_thread.start()

        # Wait for the p-kernel to accept this process (see
        # handle_run_response), or for the session to end without it.
        self._app_start.wait()
        try:
            self.run_app()
        except SystemExit:
            # A kill that arrived as the application finished.
            if not self._app_killed:
                raise

        self._io_thread.join()
        self.io_loop.close()
        return


if __name__ == "__main__":
    # Expecting parameters on Unix command line:
    # - loopback port number for p-kernel control session
    # - DarqOS process identifier (dpid)
    # - parent's DarqOS process identifier (zero if started by the p-kernel)
    # - executable path
    #
    # Within the executable path, there must be a Python file (module)
    # called 'main.py'.  In that file must be a function called
    # 'darq_main', which is called with no parameters.

    if len(sys.argv) == 2 and sys.argv[1] in ('help', '-h', '-?', '--help'):
        sys.stdout.write(f"Usage: {os.path.basename(sys.argv[0])} "
                         "p-kernel-port darq-process-id parent-darq-process-id executable-path\n\n")
        sys.exit(1)

    if len(sys.argv) != 5:
        logging.error(f"Expecting 5 params, received {len(sys.argv)}")
        sys.exit(42)

    # Configure logging.
    logging.basicConfig(stream=sys.stderr,
                        format='%(asctime)s pyloader %(levelname)8s %(message)s',
                        level=logging.DEBUG)
    logging.info("Starting pyloader.")

    # Process arguments.
    pkernel_port = int(sys.argv[1])
    dpid = int(sys.argv[2])
    parent_dpid = int(sys.argv[3])
    exec_path = sys.argv[4]

    # Create local process state.
    pproc = PythonPProcess(pkernel_port, dpid, parent_dpid, exec_path)

    # Connect to p-kernel.
    pproc.connect_to_p_kernel()
    pproc.send_run_request()

    # Run the I/O thread, handling events from the p-kernel (starting with
    # the RUN_RESPONSE that starts the application), and the application on
    # this thread.  The I/O thread disconnects from the p-kernel.
    pproc.run()

    # Exit, even if the application left threads running: the p-kernel
    # already considers this process finished.
    logging.info("Exiting.")
    logging.shutdown()
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(pproc.exit_status)
