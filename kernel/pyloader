# This is the DarqOS loader for Python executables.  It is responsible for:
# - Establishing the control session with the p-kernel
# - Passing p-call requests/messages to the p-kernel
# - Delivering p-call responses to the application
# - Executing the application code
#
# There are two threads created by this stub.  The first (main) thread
# runs an event loop servicing the socket connection to the p-kernel,
# and monitoring the second (application) thread.  The application
# thread is spawned by the main thread, to execute the darq_main()
# function from the default module of the specified executable.

import ctypes
import logging
import os
import queue
import setproctitle
import socket
import sys
import threading
import time
import typing

import darq


class PythonPProcess:
    def __init__(self, pkernel_port: int, dpid: int, parent_dpid: int, exec_path: str):
        logging.info(f"Darq PID [{dpid}], parent [{parent_dpid}], host PID [{os.getpid()}] from [{exec_path}]")

        self._pkernel_port = pkernel_port
        self._dpid = dpid
        self._parent_dpid = parent_dpid
        self._exec_path = exec_path

        # Set host process title to assist with debugging.
        setproctitle.setproctitle(f"darq-{self._dpid}")

        # Connection to p-Kernel process.
        self._pkernel_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

        # p-Call request queue from application threads (queue is thread-safe).
        self._requests = queue.Queue()

        # Event loop wakeup mechanism for p-call request queue.  This is a
        # socket pair, rather than a pipe, so the event loop can monitor it.
        self._queue_wakeup_reader, self._queue_wakeup_writer = socket.socketpair()
        self._queue_wakeup_reader.setblocking(False)

        # p-Calls sent to the p-kernel and awaiting a response, by request_id.
        # Only accessed from the main thread.
        self._pending: dict[int, darq.SystemCallState] = {}

        # Open ports, by port number.
        self.ports: dict[int, darq.PortState] = {}

        # Thread exit notification pipe.
        self._exit_pipe_reader, self._exit_pipe_writer = os.pipe()

        # Transaction identifiers for p-kernel requests.  Only accessed from
        # the main thread.
        self.request_id: int = 0

        # Re-assembly buffer.
        self.recv_buffer = darq.Buffer()

        # Thread running the application's darq_main().
        self._app_thread: threading.Thread | None = None

        # Host process exit status.
        self.exit_status: int = 0

        # Event loop.
        self.loop = darq.SelectEventLoop()
        self.loop.add_socket(self._queue_wakeup_reader, self)
        return
        
    def getpid(self) -> int:
        """Return the DarqOS process identifier for this p-process."""
        return self._dpid

    def getppid(self) -> int:
        """Return the DarqOS process identifier for the parent of this p-process."""
        return self._parent_dpid

    def get_next_request_id(self) -> int:
        """Return the next unused request identifier for this p-process.

        """
        self.request_id += 1
        return self.request_id

    def queue_new_syscall(self, syscall_state: darq.SystemCallState):
        """Queue a system call to be sent to the p-kernel."""
        self._requests.put(syscall_state)

        written = self._queue_wakeup_writer.send(b'X')
        if written != 1:
            raise Exception("failed to write byte to the queue wakeup socket !?")
        return

    def handle_syscall_queue(self):
        """Send queued p-calls from the application thread to the p-kernel."""

        # Drain the wakeup socket.
        try:
            while self._queue_wakeup_reader.recv(4096):
                pass
        except BlockingIOError:
            pass

        while True:
            try:
                syscall = self._requests.get_nowait()
            except queue.Empty:
                return

            # Requests with a request_id expect a response: assign the
            # identifier, and record them before sending, so the response
            # can be matched.
            request = syscall.get_request()
            if hasattr(request, "request_id"):
                request.request_id = self.get_next_request_id()
                self._pending[request.request_id] = syscall

            self.send_to_p_kernel(request)

    def complete_syscall(self, response) -> darq.SystemCallState | None:
        """Match a p-kernel response to its pending p-call, and complete it.

        :param response: Decoded response message, with a request_id.
        :returns: The completed p-call state, or None if unknown."""

        syscall = self._pending.pop(response.request_id, None)
        if syscall is None:
            logging.warning(f"Response to unknown request {response.request_id}")
            return None

        syscall.set_response(response)

        if syscall.get_mode() == darq.SystemCallMode.SYNC:
            syscall.notify()
        else:
            # FIXME: callbacks must run on the application's loop, which
            # needs a thread-safe way to post to it.
            logging.warning(f"Mode {syscall.get_mode()} completion not implemented")
        return syscall

    def signal_app_thread_exit(self):
        """Call to signal loader that the user thread target function has exited."""
        written = os.write(self._exit_pipe_writer, b'X')
        if written != 1:
            raise Exception("failed to write byte to thread exit pipe")
        return

    def connect_to_p_kernel(self):
        """Establish the TCP connection to the p-kernel."""

        self._pkernel_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.loop.add_socket(self._pkernel_sock, self)
        self._pkernel_sock.connect(('localhost', self._pkernel_port))
        return

    def on_readable(self, sock: socket.socket):
        logging.debug("Callback: socket is readable")

        if sock is self._queue_wakeup_reader:
            self.handle_syscall_queue()
            return

        try:
            data = sock.recv(65536)
        except ConnectionResetError:
            data = b''

        if not data:
            self.handle_p_kernel_disconnect()
            return

        self.handle_bytes_from_p_kernel(data)

    def handle_p_kernel_disconnect(self):
        """Handle the p-kernel closing the p-call session.

        Without the p-kernel, this process can't continue: kill the
        application and exit."""
        logging.error("Disconnected by p-kernel: exiting.")
        self.exit_status = 1

        self.loop.cancel_socket(self._pkernel_sock)
        self._pkernel_sock.close()
        self._pkernel_sock = None

        self.kill_app()
        self._end_app()
        return

    def on_writeable(self, sock: socket.socket):
        #logging.debug("Callback: socket is writeable")
        pass

    def on_connected(self, sock: socket.socket):
        logging.debug("Callback: socket is connected")
        pass

    def send_to_p_kernel(self, message: darq.Message):
        """Send a "syscall" message to the p-Kernel.

        :param message: Message to send."""
        if self._pkernel_sock is None:
            logging.warning(f"Not connected to p-kernel: message type {message.type} dropped")
            return

        buffer = message.encode()

        # FIXME: in an async world, this should queue and return if it can't
        # write immediately
        self._pkernel_sock.sendall(buffer)
        return

    def handle_bytes_from_p_kernel(self, buffer: bytes):

        # Append bytes to process-wide reassembly buffer.
        self.recv_buffer.append(buffer)

        while True:
            # Attempt to get message: if message is incomplete, just return.
            if self.recv_buffer.length() < 8:
                return

            header_buf = self.recv_buffer.peek(8)  # FIXME: check version, etc, first.
            message_length = darq.Message.decode_length(header_buf)
            if self.recv_buffer.length() < message_length:
                # Wait for more data to be delivered so we can decode message.
                return

            message_buf = self.recv_buffer.peek(message_length)
            self.recv_buffer.consume(message_length)  # FIXME: make this one operation
            message_type = darq.Message.decode_type(message_buf)

            self.dispatch(message_type, message_buf)

    def dispatch(self, message_type, message_buf):
        if message_type == darq.MessageType.DELIVER_MESSAGE:
            message = darq.DeliverMessage()
            message.decode(message_buf)
            self.handle_deliver_message(message)

        elif message_type == darq.MessageType.OPEN_PORT_RESP:
            message = darq.OpenPortResponse()
            message.decode(message_buf)
            self.handle_open_port_response(message)

        elif message_type == darq.MessageType.CLOSE_PORT_RESP:
            message = darq.ClosePortResponse()
            message.decode(message_buf)
            self.handle_close_port_response(message)

        elif message_type == darq.MessageType.SPAWN_PROCESS_RESP:
            message = darq.SpawnProcessResponse(0, 0, 0, None)
            message.decode(message_buf)
            self.complete_syscall(message)

        elif message_type == darq.MessageType.KILL_PROCESS_RQST:
            message = darq.KillProcessRequest()
            message.decode(message_buf)
            self.handle_kill_process_request(message)

        elif message_type == darq.MessageType.KILL_PROCESS_RESP:
            message = darq.KillProcessResponse()
            message.decode(message_buf)
            self.complete_syscall(message)

        else:
            logging.warning(f"Unhandled message type: {message_type}")

    def disconnect(self):

        # Send exit message to p-kernel?

        # Close socket (and flush buffers).
        if self._pkernel_sock is not None:
            self._pkernel_sock.close()
            self._pkernel_sock = None

    def send_running_message(self):
        # Send startup confirmation to p-kernel.
        message = darq.Running()
        message.dpid = self._dpid
        message.host_pid = os.getpid()
        self.send_to_p_kernel(message)
        return

    def handle_deliver_message(self, message: darq.DeliverMessage):
        # Check destination.
        if message.destination not in self.ports:
            self.listener.on_error(0, 0, "Bad port")
            return

        self.listener.on_message(message.source, message.destination, message.payload)
        return


    def handle_open_port_response(self, message: darq.OpenPortResponse):
        if self.complete_syscall(message) is None:
            return

        # Record the newly-opened port.
        if message.result == 0:
            port_state = darq.PortState(message.port)
            port_state.is_open = True
            self.ports[message.port] = port_state
        return

    def handle_close_port_response(self, message: darq.ClosePortResponse):
        if self.complete_syscall(message) is None:
            return

        self.ports.pop(message.port, None)
        return

    def start_app(self):
        # Create top-level namespace for application code.
        app_globals = {}
        app_globals["_darq_process_state"] = self

        # Add executable path to system path.
        launcher = \
            "# language=Python\n" \
            "import logging\n" \
            "import sys\n" \
            "import threading\n" \
            "\n" \
            "# Add executable module's location to system path.\n" \
            f"sys.path.insert(0, '{self._exec_path}')\n" \
            "\n" \
            "# Import the application's main module,\n" \
            "import main\n" \
            "" \
            "# Inject the process state structure into the syscall module.\n" \
            "import darq; darq.syscall.__dict__['_darq_process_state'] = _darq_process_state\n" \
            "\n" \
            "# Run the application's main function, exiting quietly when\n" \
            "# killed (see PythonPProcess.kill_app).\n" \
            "def run_darq_main():\n" \
            "    try:\n" \
            "        main.darq_main()\n" \
            "    except SystemExit:\n" \
            "        logging.debug('Application thread killed.')\n" \
            "\n" \
            "# Start the application's main function in a new thread.\n" \
            "try:\n" \
            "    t = threading.Thread(target=run_darq_main, name='darq_main')\n" \
            "    logging.debug('Starting application thread.')\n" \
            "    t.start()\n" \
            "finally:\n" \
            "    pass #_darq_process_state\n"
        exec(launcher, app_globals)
        self._app_thread = app_globals["t"]
        return

    def handle_kill_process_request(self, message: darq.KillProcessRequest):
        """Handle the p-kernel's request to kill this process."""
        if message.dpid != self._dpid:
            logging.warning(f"Kill request for DPID [{message.dpid}] ignored")
            return

        logging.info("Killed by p-kernel.")
        self.kill_app()
        self._end_app()
        return

    def kill_app(self, timeout: float = 1.0) -> bool:
        """Kill the application thread.

        :param timeout: Seconds to wait for the thread to exit.
        :returns: True if the thread has exited."""

        thread = self._app_thread
        if thread is None or not thread.is_alive():
            return True

        # Raise SystemExit in the application thread.  Python delivers it
        # when the thread next executes bytecode, so it won't interrupt a
        # thread blocked in native code.
        ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(thread.ident),
                                                   ctypes.py_object(SystemExit))

        # Wake any p-calls the thread is blocked on, so it sees the exception.
        while True:
            try:
                self._requests.get_nowait().notify()
            except queue.Empty:
                break

        for syscall in self._pending.values():
            syscall.notify()
        self._pending.clear()

        thread.join(timeout)
        return not thread.is_alive()

    def _end_app(self):
        """End this process, once the application thread is dead."""

        # FIXME: confirm death to p-kernel.

        if self._app_thread is not None and self._app_thread.is_alive():
            # Stuck in native code: the interpreter won't exit while it runs.
            logging.error("Application thread did not exit: exiting forcibly.")
            os._exit(1)

        # Leave the event loop: the main thread then disconnects and exits.
        self.loop.stop()
        return

    def run(self):
        """Loop, handling p-kernel messages and application events."""

        self.loop.run()
        return


if __name__ == "__main__":
    # Expecting parameters on Unix command line:
    # - loopback port number for p-kernel control session
    # - DarqOS process identifier (dpid)
    # - parent's DarqOS process identifier (zero if started by the p-kernel)
    # - executable path
    #
    # Within the executable path, there must be a Python file (module)
    # called 'main.py'.  In that file must be a function called
    # 'darq_main', which is called with no parameters.

    if len(sys.argv) == 2 and sys.argv[1] in ('help', '-h', '-?', '--help'):
        sys.stdout.write(f"Usage: {os.path.basename(sys.argv[0])} p-kernel-port darq-process-id parent-darq-process-id executable-path\n\n")
        sys.exit(1)

    if len(sys.argv) != 5:
        logging.error(f"Expecting 5 params, received {len(sys.argv)}")
        sys.exit(42)

    # Configure logging.
    logging.basicConfig(stream=sys.stderr,
                        format='%(asctime)s pyloader %(levelname)8s %(message)s',
                        level=logging.DEBUG)
    logging.info("Starting pyloader.")

    # Process arguments.
    pkernel_port = int(sys.argv[1])
    dpid = int(sys.argv[2])
    parent_dpid = int(sys.argv[3])
    exec_path = sys.argv[4]

    # Create local process state.
    pproc = PythonPProcess(pkernel_port, dpid, parent_dpid, exec_path)

    # Connect to p-kernel.
    pproc.connect_to_p_kernel()
    pproc.send_running_message()

    # Start the application code in a new thread.
    pproc.start_app()

    # Wait for events, either from app code, or from p-kernel.
    pproc.run()

    # Disconnect (nicely) from p-kernel.
    pproc.disconnect()

    # Exit.
    logging.info("Exiting.")
    sys.exit(pproc.exit_status)
