#! /bin/bash
# darqos
# Copyright (C) 2023-2024, David Arnold

# Make a distribution snapshot

EDITION='1'

rm -rf dist
mkdir -p "dist/darq"

root=$(pwd)
destdir="$root/dist/darq"

# Runtime package.
rm -rf dist
python -m build
mkdir -p "$destdir/lib"
cp -p dist/darq-*-py3-none-any.whl "$destdir/lib/"
echo "darq.whl"

# p-Kernel.
mkdir -p "$destdir/kernel"
cp -p "$root"/kernel/pkernel "$destdir/kernel/"
cp -p "$root"/kernel/pyloader "$destdir/kernel/"
cp -p "$root"/kernel/darqos-pkernel "$destdir/kernel/"
cp -p "$root"/kernel/darqos-pkernel.service "$destdir/kernel/"
cp -p "$root"/kernel/darqos.target "$destdir/kernel/"
echo "kernel"

# Services.
mkdir -p "$destdir/services"
# Services are spawned by the p-kernel: only their code is needed.
for f in "$root"/services/*/*.py ; do
  t=${f#"$root"}
  mkdir -p `dirname $destdir/$t`
  cp -p $f $destdir/$t
  echo $t
done

# Types.
mkdir -p "$destdir/types"
for f in `find "$root/types" -name "*.py" -print`; do
  t=${f#"$root"}
  mkdir -p `dirname $destdir/$t`
  cp -p $f $destdir/$t
  echo $t
done

# Lenses.
mkdir -p "$destdir/lenses"
for f in `find "$root/lenses" -name "*.py" -print`; do
  t=${f#"$root"}
  mkdir -p `dirname $destdir/$t`
  cp -p $f $destdir/$t
  echo $t
done

# DIDL protocol sources.
mkdir -p "$destdir/lib/didl"
for f in "$root"/lib/didl/*.didl; do
  cp -p "$f" "$destdir/lib/didl/"
  echo "/lib/didl/`basename $f`"
done

# The C DIPC runtime, for code generated by didlcgen.
mkdir -p "$destdir/lib/c/darq"
for f in "$root"/lib/c/darq/*.[ch]; do
  cp -p "$f" "$destdir/lib/c/darq/"
  echo "/lib/c/darq/`basename $f`"
done

# System scripts and tools.
mkdir -p "$destdir/bin"
for f in dui install didlc didlpygen didlcgen; do
  cp -p "$root/bin/$f" "$destdir/bin/"
  echo "/bin/$f"
done

# Manual pages.
mkdir -p "$destdir/man"
for f in "$root"/man/*.[1-8]; do
  cp -p "$f" "$destdir/man/"
  echo "/man/`basename $f`"
done

# Make archive.
name=darqos-${EDITION}ed-snap`date +%Y%m%d`.tar
rm -f $name.gz

cd dist
export COPYFILE_DISABLE=1
tar cvf ../$name darq
cd ..
gzip -9 $name

# Cleanup.
rm -rf dist
