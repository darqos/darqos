#! /bin/bash
# darqos
# Copyright (C) 2023-2026, David Arnold

# Make a distribution tarball (see doc/distribution.rst): the files git
# tracks in the directories install(8) installs, as they are in the
# working tree, under darq/, with a VERSION file naming the commit.
# Files git doesn't track are left out, with a warning.
#
#     mkdist [output directory]
#
# It's written to dist/ (or the directory given), as
# darqos-1ed-snapYYYYMMDD.tar.gz.  Uncommitted changes to them make a
# "-dirty" version, with a warning: a release should be made from a
# commit.

set -euo pipefail

EDITION=1

# What's distributed: as install(8) copies it.
PATHS="bin darq kernel lib services types lenses tools compositor man requirements.txt"

root=$(cd "$(dirname "$0")" && pwd)
cd "$root"
out=$(mkdir -p "${1:-dist}" && cd "${1:-dist}" && pwd)

# The commit, "-dirty" if what's distributed has changed since; and a
# warning about files git doesn't track, which are left out.
version=$(git describe --always)
# shellcheck disable=SC2086
if [ -n "$(git status --porcelain --untracked-files=no -- $PATHS)" ]; then
    version="$version-dirty"
    echo "Warning: uncommitted changes, distributed as they are" >&2
fi
# shellcheck disable=SC2086
untracked=$(git ls-files --others --exclude-standard -- $PATHS)
if [ -n "$untracked" ]; then
    echo "Warning: files git doesn't track, left out:" >&2
    echo "$untracked" | sed 's/^/    /' >&2
fi
version="$version $(date +%Y-%m-%d)"

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/darq"

# shellcheck disable=SC2086
git ls-files -z -- $PATHS | while IFS= read -r -d '' file; do
    # Deleted, but not yet committed.
    [ -e "$file" ] || continue
    mkdir -p "$stage/darq/$(dirname "$file")"
    cp -p "$file" "$stage/darq/$file"
done
echo "$version" > "$stage/darq/VERSION"

name="darqos-${EDITION}ed-snap$(date +%Y%m%d).tar.gz"
tar -C "$stage" --owner=0 --group=0 --sort=name -czf "$out/$name" darq
echo "Ok: $out/$name ($version, $(find "$stage/darq" -type f | wc -l) files)"
