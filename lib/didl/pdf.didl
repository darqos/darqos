// Copyright (C) 2026 David Arnold
//
// PDF item protocol: see doc/pdf-type.rst.
//
// A PDF item is read-only: rendering it is left to its clients.

library darq.pdf;

// The item port of a PDF item, returned by its implementation's
// CreateFrom and Open (see lib/didl/type.didl).
protocol Pdf {
    // As Item.Close.
    1: Close() -> ();

    // The operator's looking at the item, through a client, such as a
    // lens, named by source, with a note of where they've got to, such
    // as "page 45 of 296": recorded as "viewed" (see doc/history.rst).
    // Changes made through this port are recorded with its source too.
    // It's one-way.
    2: Viewed(string source, string note);

    // Return the PDF.
    16: Get() -> (opaque data);

    // Return the PDF's size, in bytes, and its number of pages: 0 if
    // it's protected by a password, so it can't be read.
    17: Stat() -> (uint64 size, uint32 pages);

    // Return where the reader had got to: a string only a lens makes
    // sense of, empty if it hasn't been read.
    18: GetPosition() -> (string position);

    // Record where the reader's got to.  Writing it rewrites the blob,
    // PDF included, so it's for closing a document, rather than each page.
    19: SetPosition(string position) -> ();
}
