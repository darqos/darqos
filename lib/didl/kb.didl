// darqos
// Copyright (C) 2026 David Arnold
//
// Knowledge Base service protocol: see doc/kb-service.rst.
//
// Entities are items and properties, with string identifiers: a
// Wikidata identifier, such as Q42 or P31, or a UUID.  DIDL has no
// unions or optional fields, so a value is a struct tagged by its type,
// and an absent string is empty.

library darq.kb;

enum Status : uint32 {
    OK = 0;

    // No such entity.
    NOT_FOUND = 1;

    // An identifier, cursor, or value isn't valid.
    INVALID_ARGUMENT = 2;

    // An entity has changed since the revision given, or one given as
    // new already exists.
    CONFLICT = 3;

    // A statement doesn't fit its property: the property isn't known,
    // or the value hasn't its datatype, refers to an unknown entity, or
    // is out of its bounds.
    INVALID_STATEMENT = 4;

    // A query ran past the service's time limit.
    TOO_COSTLY = 5;
}

enum Kind : uint8 {
    ITEM = 0;
    PROPERTY = 1;
}

// A property's datatype.
enum Datatype : uint8 {
    NONE = 0;
    ITEM = 1;
    PROPERTY = 2;
    STRING = 3;
    TEXT = 4;
    QUANTITY = 5;
    TIME = 6;
    URL = 7;
    EXTERNAL_ID = 8;
}

enum Rank : uint8 {
    NORMAL = 0;
    PREFERRED = 1;
    DEPRECATED = 2;
}

enum ValueType : uint8 {
    ENTITY = 0;
    STRING = 1;
    TEXT = 2;
    QUANTITY = 3;
    TIME = 4;
}

// Where a link to an entity is, in a statement.
enum Role : uint8 {
    MAIN = 0;
    QUALIFIER = 1;
    REFERENCE = 2;
}

// How FindByLabel matches.
enum Match : uint8 {
    // A label, exactly.
    EXACT = 0;

    // A label or alias with words starting with each of the text's
    // words, ignoring case.
    WORDS = 1;
}

// Text in a language, by language tag, such as "en" or "en-AU": a
// label, description, alias, or part of a text value.
struct Text {
    string language;
    string text;
}

// A value: only its type's fields are used.
struct Value {
    ValueType type;

    // ENTITY: the entity's identifier.  QUANTITY: its unit's, or empty
    // for none.
    string entity_id;

    // STRING.
    string string_value;

    // TEXT: one per language.
    sequence<Text> text;

    // QUANTITY: decimals, which keep their significant digits, with
    // empty bounds for none.
    string amount;
    string lower;
    string upper;

    // TIME: the fields the precision covers are set, and the others are
    // 0.  The year is negative for BCE.  The bounds are counted in
    // units of the precision; an empty calendar is gregorian.
    int64 year;
    uint8 month;
    uint8 day;
    uint8 hour;
    uint8 minute;
    uint8 second;
    uint32 nanosecond;
    uint8 precision;
    uint32 before;
    uint32 after;
    string calendar;
}

// A property and its value.
struct Snak {
    string property_id;
    Value value;
}

// A source for a statement.
struct Reference {
    sequence<Snak> snaks;
}

struct Statement {
    // Unique within its entity: a UUID.
    string id;

    Snak main_snak;
    sequence<Snak> qualifiers;
    sequence<Reference> references;
    Rank rank;
}

struct Entity {
    string id;
    Kind kind;

    // A property's datatype; NONE for an item.
    Datatype datatype;

    // The revision it was read at, or 0 for a new entity.
    uint64 revision;

    // One label and description per language, and any number of
    // aliases.
    sequence<Text> labels;
    sequence<Text> descriptions;
    sequence<Text> aliases;

    sequence<Statement> statements;

    // The entity a merged one redirects to, or empty.
    string redirect;

    // A destroyed entity is kept, but left out of lookups.
    bool destroyed;
}

// An entity's label, in the first language of a chain that it has one
// in.
struct Label {
    string entity_id;
    string language;
    string text;
}

// A query's term: a variable, by its number, from 1, or a constant: an
// entity's identifier, a string value, or, as an object, any value.
enum TermType : uint8 {
    VARIABLE = 0;
    ENTITY = 1;
    STRING = 2;
    ANY = 3;
}

struct Term {
    TermType type;

    // VARIABLE.
    uint8 variable;

    // ENTITY: the entity's identifier.  STRING: the value.
    string value;
}

// How many times a pattern's property is followed, from its subject to
// its object.
enum Repeat : uint8 {
    ONCE = 0;
    ONE_OR_MORE = 1;
    ZERO_OR_MORE = 2;
}

// A query's pattern: an entity, the subject, with a statement that has
// a snak of a property, in a role, with a value, the object.  Patterns
// with the same statement variable (0 for none) match the same
// statement.  A negated pattern must not match.
struct Pattern {
    Term subject;
    string property_id;
    Term object;
    Role role;
    uint8 statement;
    Repeat repeat;
    bool negated;
}

// A query's result: the values of its selected variables, in order:
// entity identifiers, string values, or statement identifiers.
struct Row {
    sequence<string> values;
}

// The Knowledge Base service, registered as "darq.kb".
//
// Lookups return identifiers sorted, in batches: at most max (0 for the
// service's limit), after the identifier after (empty for the first
// batch).  To get the next batch, ask again with after set to the last
// identifier returned.  Destroyed and merged entities are left out.
protocol KB {
    // Return the entities with some identifiers, in that order, leaving
    // out those that don't exist.  With follow, a merged entity's
    // redirect is followed.  If languages isn't empty, labels has the
    // labels, in that chain of languages, of the entities the returned
    // ones refer to.
    1: GetEntities(sequence<string> ids, bool follow, sequence<string> languages) -> (sequence<Entity> entities, sequence<Label> labels, Status status);

    // Write entities, whole, all or none.  Each has the revision it was
    // read at, or 0 if it's new; a new one with an empty identifier is
    // given a UUID.  Returns the entities as written, with their new
    // revisions; or, if one fails, its identifier, and why.
    2: PutEntities(sequence<Entity> entities) -> (sequence<Entity> entities, string failed_id, Status status);

    // Merge one entity into another: its statements move to the other,
    // its labels and aliases become the other's aliases, and it
    // redirects to the other.
    3: Merge(string old_id, string new_id) -> (Status status);

    // Mark an entity destroyed, keeping its statements, and the links
    // to it.
    4: Destroy(string entity_id) -> (Status status);

    // Find entities by label.  If class_id isn't empty, only instances
    // of the class, or of its subclasses, are found.
    5: FindByLabel(string text, string language, Match match, string class_id, uint32 max, string after) -> (sequence<string> ids, Status status);

    // Find entities with a string value for a property.  Values are
    // compared normalised: ignoring case, and with a phone number just
    // its digits.
    6: FindByValue(string property_id, string value, uint32 max, string after) -> (sequence<string> ids, Status status);

    // Find the entities that link to one, by a property (or any, if
    // it's empty), in a statement's role.
    7: FindLinks(string target_id, string property_id, Role role, uint32 max, string after) -> (sequence<string> ids, Status status);

    // Find the instances of a class, or of any of its subclasses.
    8: Instances(string class_id, uint32 max, string after) -> (sequence<string> ids, Status status);

    // Have changes to some entities (or all, if ids is empty) reported
    // to a listener, which serves Listener, until it's unwatched, or
    // its port is destroyed.
    9: Watch(sequence<string> ids, port listener) -> (uint32 watch_id, Status status);
    10: Unwatch(uint32 watch_id) -> (Status status);

    // Find what matches all of a query's patterns: a row of the values
    // of the selected variables (or of all, if select is empty) for
    // each, without duplicates.  Deprecated statements match only with
    // deprecated.  Rows are sorted, and returned in batches, as
    // lookups are: at most max, after the row after (empty for the
    // first batch).  If languages isn't empty, labels has the labels of
    // the entities in the rows, in that chain of languages.
    11: Query(sequence<Pattern> patterns, sequence<uint8> select, bool deprecated, sequence<string> languages, uint32 max, sequence<string> after) -> (sequence<Row> rows, sequence<Label> labels, Status status);
}

// Served by the KB type implementation (types/kb) on its Implementation
// port, beside the Implementation protocol, from 16.  An entity of one of
// its kinds is written through it, not to the KB service directly (see
// doc/types.rst), so it sees every change to its items.
protocol EntityWriter {
    // Write entities, as the KB's PutEntities, all or none.  An existing
    // entity's kind, its DarqOS type statements, stays as it was, and a
    // new one can't have one: an item of a kind is made by Create.
    16: WriteEntities(sequence<Entity> entities) -> (sequence<Entity> entities, string failed_id, Status status);

    // Merge one entity into another, as the KB's Merge.
    17: MergeEntity(string old_id, string new_id) -> (Status status);

    // Mark an entity destroyed, as the KB's Destroy.
    18: DestroyEntity(string entity_id) -> (Status status);
}

// Served by a watcher, on the port it gives Watch.
protocol Listener {
    // An entity was changed, to a revision.  Sent after the change is
    // committed.
    1: Changed(string entity_id, uint64 revision);
}

// An entity an item refers to, that refers to it, or that's found, as
// an item: its item identifier (empty for a property, which isn't an
// item), its label and description in the first language of a chain
// that it has a label in (empty for none), and a property's datatype
// (NONE for an item).
struct Linked {
    string entity_id;
    string item_id;
    string language;
    string label;
    string description;
    Datatype datatype;
}

// Served by the KB type implementation (types/kb) on an item's port:
// the entity it's for, the Item protocol's Close, and its own methods
// from 16.  A merged entity's port is for the entity it redirects to.
protocol EntityItem {
    1: Close() -> ();

    // Return the entity, and the entities it refers to, with their
    // labels in a chain of languages.
    16: GetEntity(sequence<string> languages) -> (Entity entity, sequence<Linked> linked, Status status);

    // Write the entity, whole, as read at its revision: as PutEntities.
    // Its kind, its DarqOS type statements, can't be changed.
    17: PutEntity(Entity entity) -> (uint64 revision, Status status);

    // Return the entities that link to this one, by a property (or any,
    // if it's empty), in a statement's role, in batches, as KB lookups.
    18: GetLinks(string property_id, Role role, sequence<string> languages, uint32 max, string after) -> (sequence<Linked> linked, Status status);

    // Have changes to the entity reported to a listener, which serves
    // Listener, until its port is destroyed.
    19: WatchEntity(port listener) -> (Status status);

    // Find entities of a kind, items or properties, by the words of
    // their labels and aliases, in a chain of languages, as FindByLabel
    // does: in batches, sorted by identifier.  If class_id isn't empty,
    // only instances of the class, or of its subclasses, are found.
    20: FindEntities(string text, sequence<string> languages, Kind kind, string class_id, uint32 max, string after) -> (sequence<Linked> found, Status status);

    // Return the properties to offer first, for a new statement or
    // qualifier on this entity: the qualifiers for annotating statements
    // by hand (start and end time, and the like), then those it has.
    21: SuggestProperties(sequence<string> languages, uint32 max) -> (sequence<Linked> found, Status status);
}
