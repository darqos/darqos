#! /bin/bash
# DarqOS
# Copyright (C) 2023-2026 David Arnold

# Install, or update, DarqOS from an unpacked distribution (see
# install(8), and doc/distribution.rst): normally /darq/dist/darq, run
# by dui(8), as root, on Debian 13.
#
#     install [--boot]
#
# It installs from the distribution it's in, into /darq; or, run from
# /darq itself (as "/darq/bin/install --boot"), does everything but
# copying the code:
#
# - stop DarqOS, if it's running;
# - install the Debian packages it needs;
# - create the darq user;
# - copy the code into /darq, as source, removing what's gone;
# - build the compositor;
# - make or update the Python environment, /darq/env;
# - create the run directory, /darq/run, owned by darq;
# - install the systemd units, and the backup configuration;
# - enable the daily backup;
# - with --boot, make DarqOS the machine's default boot; and
# - start DarqOS again, if it was running.
#
# Its output is logged in /var/log/darqos.
#
# DARQ and LOG_DIR override where it installs and logs.  For tests,
# DARQOS_INSTALL_SKIP names steps to skip: any of root, stop, packages,
# user, owner, compositor, venv, units, backup, boot and start.

set -euo pipefail

DIST=$(cd "$(dirname "$0")/.." && pwd)
DARQ=${DARQ:-/darq}
DARQ_USER=darq
LOG_DIR=${LOG_DIR:-/var/log/darqos}
UNIT_DIR=/etc/systemd/system
CONF_DIR=/etc/darqos
SKIP=" ${DARQOS_INSTALL_SKIP:-} "

# The code's directories, copied whole; and its files.
CODE="bin darq kernel lib services types lenses tools compositor"
FILES="requirements.txt VERSION"

# The units, from kernel/.
UNITS="darqos-pkernel.service darqos.target darqos-backup.service darqos-backup.timer"

# Debian packages: for building the compositor; for running it, and
# Qt (whose wheels bring Qt, but not these); polkit, without which
# logind lets only root power off or reboot; and for the backups.
PACKAGES="
    python3.13-venv polkitd
    meson ninja-build pkgconf gcc
    libwlroots-0.18-dev libwayland-dev wayland-protocols libxkbcommon-dev
    libgl1 libegl1 libgl1-mesa-dri libegl-mesa0 libwayland-egl1 libwayland-cursor0
    libfontconfig1 libdbus-1-3 libxkbcommon0 libglib2.0-0t64 fonts-dejavu-core
    sqlite3 rsync
"

BOOT=0
for arg in "$@"; do
    case "$arg" in
        --boot) BOOT=1 ;;
        *) echo "Usage: install [--boot]" >&2; exit 2 ;;
    esac
done

# Whether to do a step: not if it's skipped.
step() {
    case "$SKIP" in
        *" $1 "*) return 1 ;;
    esac
    return 0
}

if step root && [ "$(id -u)" != 0 ]; then
    echo "Error: must run as root" >&2
    exit 1
fi

# Log everything, as well as showing it.
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/install-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1
VERSION=$(sed -n 's/^version=//p' "$DIST/VERSION" 2>/dev/null || true)
echo "Ok: installing version ${VERSION:-unknown} from $DIST into $DARQ"
trap 'echo "Error: install failed (line $LINENO): see $LOG"' ERR

# Stop DarqOS, remembering whether it was running.
WAS_RUNNING=0
if step stop; then
    if systemctl is-active --quiet darqos-pkernel.service; then
        WAS_RUNNING=1
        systemctl stop darqos-pkernel.service
        echo "Ok: stopped DarqOS"
    fi
fi

if step packages; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # shellcheck disable=SC2086
    apt-get install -y $PACKAGES
    echo "Ok: installed Debian packages"
fi

if step user && ! id "$DARQ_USER" >/dev/null 2>&1; then
    useradd --create-home --user-group --shell /bin/bash "$DARQ_USER"
    echo "Ok: created user $DARQ_USER"
fi

# The code, owned by whoever installs it (root), not by the
# distribution's owners, and writable only by its owner, whatever the
# umask it was made with: darq runs it, but can't change it.  The
# compositor's build is kept, to build again from.  Run from the
# installation itself, it's already there.
mkdir -p "$DARQ"
chmod 0755 "$DARQ"
if [ "$(cd "$DIST" && pwd -P)" = "$(cd "$DARQ" && pwd -P)" ]; then
    echo "Ok: installing in place: the code isn't copied"
else
    for dir in $CODE; do
        rsync -rlptD --chmod=go-w --delete --exclude /build/ --exclude __pycache__/ "$DIST/$dir/" "$DARQ/$dir/"
    done
    for file in $FILES; do
        if [ -f "$DIST/$file" ]; then
            cp --preserve=mode,timestamps "$DIST/$file" "$DARQ/$file"
            chmod go-w "$DARQ/$file"
        fi
    done
    # The manual pages, by section: read them with "man -M /darq/man".
    rm -rf "$DARQ/man"
    for page in "$DIST"/man/*.[1-8]; do
        mkdir -p "$DARQ/man/man${page##*.}"
        cp --preserve=mode,timestamps "$page" "$DARQ/man/man${page##*.}/"
    done
    chmod -R go-w "$DARQ/man"
    echo "Ok: copied the code"
fi

if step compositor; then
    (
        cd "$DARQ/compositor"
        if [ ! -d build ]; then
            meson setup build
        fi
        meson compile -C build
    )
    echo "Ok: built the compositor"
fi

if step venv; then
    # Remake an environment that uses the system's packages, as earlier
    # installs' did: everything comes from requirements.txt now.
    if grep -qs "include-system-site-packages = true" "$DARQ/env/pyvenv.cfg"; then
        rm -rf "$DARQ/env"
    fi
    if [ ! -x "$DARQ/env/bin/python" ]; then
        python3.13 -m venv "$DARQ/env"
    fi
    "$DARQ/env/bin/pip" install --quiet --upgrade pip
    "$DARQ/env/bin/pip" install --quiet --upgrade -r "$DARQ/requirements.txt"
    # Compiled now, since darq can't write the code's __pycache__.
    "$DARQ/env/bin/python" -m compileall -q $(for dir in $CODE; do echo "$DARQ/$dir"; done) || true
    echo "Ok: updated the Python environment"
fi

# The run directory, and its files, whatever umask made them: only
# darq may read them.
mkdir -p "$DARQ/run"
chmod -R go-rwx "$DARQ/run"
if step owner; then
    chown -R "$DARQ_USER:$DARQ_USER" "$DARQ/run"
fi
echo "Ok: run directory $DARQ/run"

if step units; then
    for unit in $UNITS; do
        # Not through a link an earlier install made into /darq.
        rm -f "$UNIT_DIR/$unit"
        cp "$DARQ/kernel/$unit" "$UNIT_DIR/$unit"
    done
    systemctl daemon-reload
    mkdir -p "$CONF_DIR"
    if [ ! -f "$CONF_DIR/backup.conf" ]; then
        cp "$DARQ/kernel/backup.conf" "$CONF_DIR/backup.conf"
        echo "Ok: created $CONF_DIR/backup.conf"
    fi
    echo "Ok: installed systemd units"
fi

if step backup; then
    systemctl enable --now darqos-backup.timer
    echo "Ok: enabled the daily backup"
fi

if [ "$BOOT" = 1 ] && step boot; then
    systemctl enable darqos-pkernel.service
    systemctl set-default darqos.target
    echo "Ok: DarqOS is the default boot"
fi

if [ "$WAS_RUNNING" = 1 ] && step start; then
    systemctl start darqos-pkernel.service
    echo "Ok: started DarqOS"
fi

echo "Ok: installed"
