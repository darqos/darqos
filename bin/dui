#! /bin/bash
# DarqOS
# Copyright (C) 2023-2026 David Arnold

# DarqOS Updater/Installer (see dui(8))
#
#     dui [--boot] [TARBALL]
#
# Installs, or updates, DarqOS from a distribution tarball, made by
# mkdist: a local file, or by default the latest, downloaded.  It
# unpacks it into /darq/dist, and runs the install(8) script it holds,
# passing it --boot.

set -euo pipefail

DARQ=${DARQ:-/darq}
DIST=${DIST:-$DARQ/dist}
DIST_FILE=${DIST_FILE:-darqos-latest.tar.gz}
DIST_BASE=${DIST_BASE:-https://www.0x1.org/d/darq}

options=()
tarball=
for arg in "$@"; do
    case "$arg" in
        --boot) options+=(--boot) ;;
        -*) echo "Usage: dui [--boot] [TARBALL]" >&2; exit 2 ;;
        *) tarball=$(realpath "$arg") ;;
    esac
done

if [ "$(id -u)" != 0 ]; then
    echo "Error: must run as root" >&2
    exit 1
fi

# Fetch the tarball, unless it's given.
if [ -z "$tarball" ]; then
    tarball=/tmp/$DIST_FILE
    rm -f "$tarball"
    if ! wget -O "$tarball" "$DIST_BASE/$DIST_FILE"; then
        echo "Error: couldn't download $DIST_BASE/$DIST_FILE" >&2
        exit 1
    fi
    echo "Ok: downloaded $DIST_BASE/$DIST_FILE"
fi
if [ ! -f "$tarball" ]; then
    echo "Error: no tarball $tarball" >&2
    exit 1
fi

# Unpack it, in place of the last.
rm -rf "$DIST"
mkdir -p "$DIST"
tar -C "$DIST" --no-same-owner -xzf "$tarball"
if [ ! -x "$DIST/darq/bin/install" ]; then
    echo "Error: $tarball has no darq/bin/install" >&2
    exit 1
fi
echo "Ok: unpacked $tarball into $DIST"

if ! "$DIST/darq/bin/install" "${options[@]}"; then
    echo "Error: install failed" >&2
    exit 1
fi

# The unpacked files aren't used at runtime.
rm -rf "$DIST"
echo "Ok: done"
