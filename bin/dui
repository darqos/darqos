#! /bin/bash
# DarqOS
# Copyright (C) 2023-2026 David Arnold

# DarqOS Updater/Installer (see dui(8))
#
#     dui [--boot] [--pre-release] [--update] [TARBALL]
#
# Installs, or updates, DarqOS from a distribution tarball, made by
# mkdist: a local file, or by default the stable release, downloaded from
# GitHub, or, with --pre-release, the newest pre-release.  It unpacks it
# into /darq/dist, and runs the install(8) script it holds, passing it
# --boot, and --update, as darqos-update(8) does.
#
# It checks the distribution's signature, beside it (.sig), with the
# installed release key, and says what it found; but, run by hand, it
# installs it all the same, and its key with it: a manual install trusts
# the distribution it's given.

set -euo pipefail

DARQ=${DARQ:-/darq}
DIST=${DIST:-$DARQ/dist}
CONF_DIR=${CONF_DIR:-/etc/darqos}
RELEASES=${DARQOS_RELEASES:-https://api.github.com/repos/darqos/darqos/releases}
STABLE=${DARQOS_STABLE:-https://github.com/darqos/darqos/releases/latest/download/darqos.tar.gz}
NAMESPACE=darqos-release

options=()
tarball=
pre_release=0
for arg in "$@"; do
    case "$arg" in
        --boot) options+=(--boot) ;;
        --update) options+=(--update) ;;
        --pre-release) pre_release=1 ;;
        -*) echo "Usage: dui [--boot] [--pre-release] [--update] [TARBALL]" >&2; exit 2 ;;
        *) tarball=$(realpath "$arg") ;;
    esac
done

if [ "$(id -u)" != 0 ]; then
    echo "Error: must run as root" >&2
    exit 1
fi

# Fetch the tarball, and its signature, unless it's given: the stable
# release, or the newest pre-release, which GitHub's API lists.
if [ -z "$tarball" ]; then
    url=$STABLE
    if [ "$pre_release" = 1 ]; then
        url=$(wget -q -O - "$RELEASES" | python3 -c '
import json, sys
for release in json.load(sys.stdin):
    if release.get("prerelease"):
        print(next(a["browser_download_url"] for a in release["assets"] if a["name"] == "darqos.tar.gz"))
        break') || true
        if [ -z "$url" ]; then
            echo "Error: there's no pre-release" >&2
            exit 1
        fi
    fi
    tarball=/tmp/darqos.tar.gz
    rm -f "$tarball" "$tarball.sig"
    if ! wget -q -O "$tarball" "$url"; then
        echo "Error: couldn't download $url" >&2
        exit 1
    fi
    wget -q -O "$tarball.sig" "$url.sig" || rm -f "$tarball.sig"
    echo "Ok: downloaded $url"
fi

# Signed with the installed release key?  By hand, it's said, not
# required: darqos-update(8) requires it.
if [ ! -f "$tarball.sig" ]; then
    echo "Warning: $tarball isn't signed"
elif [ ! -f "$CONF_DIR/allowed_signers" ]; then
    echo "Ok: signed, but there's no installed release key to check it with"
elif ssh-keygen -Y verify -f "$CONF_DIR/allowed_signers" -I "$NAMESPACE" -n "$NAMESPACE" -s "$tarball.sig" \
        < "$tarball" >/dev/null 2>&1; then
    echo "Ok: signed with the release key"
else
    echo "Warning: its signature isn't the installed release key's: installing it, and its key, as asked"
fi
if [ ! -f "$tarball" ]; then
    echo "Error: no tarball $tarball" >&2
    exit 1
fi

# Unpack it, in place of the last.
rm -rf "$DIST"
mkdir -p "$DIST"
tar -C "$DIST" --no-same-owner -xzf "$tarball"
if [ ! -x "$DIST/darq/bin/install" ]; then
    echo "Error: $tarball has no darq/bin/install" >&2
    exit 1
fi
echo "Ok: unpacked $tarball into $DIST"

if ! "$DIST/darq/bin/install" "${options[@]}"; then
    echo "Error: install failed" >&2
    exit 1
fi

# The unpacked files aren't used at runtime.
rm -rf "$DIST"
echo "Ok: done"
