#! /usr/bin/env python3
# darqos
# Copyright (C) 2026 David Arnold


import argparse
import json
import os
import re
import sys
from typing import List, Dict, Any


# Type alignments
TYPE_MAP = {
    'bool':    {"size": 1, "align": 1},
    'int8':    {"size": 1, "align": 1}, 'uint8':   {"size": 1, "align": 1},
    'int16':   {"size": 2, "align": 2}, 'uint16':  {"size": 2, "align": 2},
    'int32':   {"size": 4, "align": 4}, 'uint32':  {"size": 4, "align": 4},
    'int64':   {"size": 8, "align": 8}, 'uint64':  {"size": 8, "align": 8},
    'real32':  {"size": 4, "align": 4}, 'real64':  {"size": 8, "align": 8},
    'opaque':  {"size": 8, "align": 4},  # uint32 offset and uint32 length of out-of-line bytes
    'string':  {"size": 8, "align": 4},  # as opaque, holding UTF-8
    'sequence': {"size": 8, "align": 4},  # uint32 offset and uint32 count of out-of-line elements
    'port':    {"size": 2, "align": 2},  # uint16 index into the message's transferred handles
}


# IR format version: increment on any change that breaks consumers
IR_VERSION = 4


# Integer types an enum may be based on, with their value ranges
INTEGER_RANGES = {
    'int8':  (-2 ** 7, 2 ** 7 - 1),   'uint8':  (0, 2 ** 8 - 1),
    'int16': (-2 ** 15, 2 ** 15 - 1), 'uint16': (0, 2 ** 16 - 1),
    'int32': (-2 ** 31, 2 ** 31 - 1), 'uint32': (0, 2 ** 32 - 1),
    'int64': (-2 ** 63, 2 ** 63 - 1), 'uint64': (0, 2 ** 64 - 1),
}


# Lexer patterns for language tokens
TOKEN_SPEC = [
    ('COMMENT',   r'\/\/.*'),
    ('LIBRARY',   r'\blibrary\b'),
    ('STRUCT',    r'\bstruct\b'),
    ('ENUM',      r'\benum\b'),
    ('PROTOCOL',  r'\bprotocol\b'),
    ('ARROW',     r'->'),
    ('NUMBER',    r'-?(?:0[xX][0-9a-fA-F]+|\d+)'),
    ('ID',        r'[a-zA-Z_][a-zA-Z0-9_\.]*'),
    ('LBRACE',    r'\{'), ('RBRACE',    r'\}'),
    ('LT',        r'<'),   ('GT',        r'>'),
    ('LPAR',      r'\('), ('RPAR',      r'\)'),
    ('SEMI',      r';'),   ('COMMA',     r','),
    ('COLON',     r':'),   ('EQUALS',    r'='),
    ('WS',        r'\s+'),
    ('MISMATCH',  r'.'),
]


class DidlError(Exception):
    """A compile error tied to a source position (1-based line and column)."""
    def __init__(self, msg: str, line: int, col: int):
        super().__init__(msg)
        self.line = line
        self.col = col


class Token:
    def __init__(self, type_: str, value: str, line: int, col: int):
        self.type = type_
        self.value = value
        self.line = line
        self.col = col

    def __repr__(self):
        return f"{self.type}({self.value})"



def lex(code: str) -> List[Token]:
    tokens = []
    regex = '|'.join(f'(?P<{pair[0]}>{pair[1]})' for pair in TOKEN_SPEC)
    line, line_start = 1, 0
    for mo in re.finditer(regex, code):
        kind = mo.lastgroup
        assert kind is not None  # every alternative is a named group
        val = mo.group(kind)
        col = mo.start() - line_start + 1
        if kind == 'MISMATCH':
            raise DidlError(f"Unexpected token characters: {val}", line, col)
        if kind != 'WS' and kind != 'COMMENT':
            tokens.append(Token(kind, val, line, col))
        # Advance line tracking past any newlines inside this match
        newlines = val.count('\n')
        if newlines:
            line += newlines
            line_start = mo.start() + val.rindex('\n') + 1
    tokens.append(Token('EOF', '', line, len(code) - line_start + 1))
    return tokens


def number(token: Token) -> int:
    """The value of a NUMBER token: decimal, or hexadecimal with 0x."""
    text = token.value.lstrip('-')
    value = int(text, 16) if text[:2].lower() == '0x' else int(text)
    return -value if token.value.startswith('-') else value


class Parser:
    def __init__(self, tokens: List[Token]):
        self.tokens = tokens
        self.pos = 0

    def peek(self) -> Token: return self.tokens[self.pos]
    def consume(self, expected_type: str) -> Token:
        t = self.peek()
        if t.type != expected_type:
            raise DidlError(f"Expected {expected_type}, got {t}", t.line, t.col)
        self.pos += 1
        return t

    def parse(self) -> Dict[str, Any]:
        ast: Dict[str, Any] = {"libraries": [], "enums": [], "structs": [], "protocols": []}
        while self.peek().type != 'EOF':
            t = self.peek()
            if t.type == 'LIBRARY':
                self.consume('LIBRARY')
                name = self.consume('ID')
                ast["libraries"].append({"name": name.value, "line": name.line, "col": name.col})
                self.consume('SEMI')
            elif t.type == 'ENUM':
                ast["enums"].append(self.parse_enum())
            elif t.type == 'STRUCT':
                ast["structs"].append(self.parse_struct())
            elif t.type == 'PROTOCOL':
                ast["protocols"].append(self.parse_protocol())
            else:
                raise DidlError(f"Unexpected global scope token: {t}", t.line, t.col)
        end = self.peek()
        ast["end"] = {"line": end.line, "col": end.col}
        return ast

    def parse_enum(self) -> Dict[str, Any]:
        self.consume('ENUM')
        name = self.consume('ID')
        self.consume('COLON')
        base = self.consume('ID')
        self.consume('LBRACE')
        members = []
        while self.peek().type != 'RBRACE':
            m_name = self.consume('ID')
            self.consume('EQUALS')
            value = self.consume('NUMBER')
            self.consume('SEMI')
            members.append({"name": m_name.value, "value": number(value),
                            "line": m_name.line, "col": m_name.col})
        self.consume('RBRACE')
        return {"name": name.value, "type": base.value, "members": members,
                "line": name.line, "col": name.col, "type_line": base.line, "type_col": base.col}

    def parse_type(self) -> Dict[str, Any]:
        """A type reference: a name, or sequence<type>."""
        t = self.consume('ID')
        if t.value != 'sequence':
            return {"type": t.value, "line": t.line, "col": t.col}
        self.consume('LT')
        element = self.parse_type()
        self.consume('GT')
        return {"type": t.value, "element": element, "line": t.line, "col": t.col}

    def parse_struct(self) -> Dict[str, Any]:
        self.consume('STRUCT')
        name = self.consume('ID')
        self.consume('LBRACE')
        fields = []
        while self.peek().type != 'RBRACE':
            type_ = self.parse_type()
            f_name = self.consume('ID')
            self.consume('SEMI')
            fields.append({**type_, "name": f_name.value, "name_line": f_name.line, "name_col": f_name.col})
        self.consume('RBRACE')
        return {"name": name.value, "raw_fields": fields, "line": name.line, "col": name.col}

    def parse_protocol(self) -> Dict[str, Any]:
        self.consume('PROTOCOL')
        name = self.consume('ID')
        self.consume('LBRACE')
        methods = []
        while self.peek().type != 'RBRACE':
            number_token = self.consume('NUMBER')
            self.consume('COLON')
            m_name = self.consume('ID')
            self.consume('LPAR')
            req = self.parse_method_args()
            self.consume('RPAR')
            resp = None  # one-way unless there is a "-> (...)" reply
            if self.peek().type == 'ARROW':
                self.consume('ARROW')
                self.consume('LPAR')
                resp = self.parse_method_args()
                self.consume('RPAR')
            self.consume('SEMI')
            methods.append({"name": m_name.value, "number": number(number_token),
                            "request": req, "response": resp,
                            "line": m_name.line, "col": m_name.col,
                            "number_line": number_token.line, "number_col": number_token.col})
        self.consume('RBRACE')
        return {"name": name.value, "methods": methods, "line": name.line, "col": name.col}

    def parse_method_args(self) -> List[Dict[str, Any]]:
        args = []
        if self.peek().type == 'RPAR':
            return args
        while True:
            type_ = self.parse_type()
            name = self.consume('ID')
            args.append({**type_, "name": name.value, "name_line": name.line, "name_col": name.col})
            if self.peek().type == 'COMMA':
                self.consume('COMMA')
                continue
            break
        return args


# The name of a message header field, which a message's own fields can't have.
HEADER_FIELDS = {"txid"}


def check_names(ast: Dict[str, Any]):
    """Checks the rules for names that layout doesn't: one library,
    which alone may have dots in its name, and fields' names unique
    within their struct, or their method's request or response."""
    libraries = ast["libraries"]
    if not libraries:
        raise DidlError("No library declaration", ast["end"]["line"], ast["end"]["col"])
    if len(libraries) > 1:
        extra = libraries[1]
        raise DidlError(f"Duplicate library declaration: {extra['name']}", extra["line"], extra["col"])

    def undotted(name: str, what: str, line: int, col: int):
        if "." in name:
            raise DidlError(f"{what} {name} may not contain dots: only the library's name may", line, col)

    def check_fields(fields: List[Dict[str, Any]], where: str, message: bool):
        seen = set()
        for f in fields:
            undotted(f["name"], "Field name", f["name_line"], f["name_col"])
            if f["name"] in seen:
                raise DidlError(f"Duplicate field in {where}: {f['name']}", f["name_line"], f["name_col"])
            if message and f["name"] in HEADER_FIELDS:
                raise DidlError(f"{where} field {f['name']} has the name of a message header field",
                                f["name_line"], f["name_col"])
            seen.add(f["name"])

    for e in ast["enums"]:
        undotted(e["name"], "Enum name", e["line"], e["col"])
        for m in e["members"]:
            undotted(m["name"], "Member name", m["line"], m["col"])
    for st in ast["structs"]:
        undotted(st["name"], "Struct name", st["line"], st["col"])
        check_fields(st["raw_fields"], st["name"], message=False)
    for p in ast["protocols"]:
        undotted(p["name"], "Protocol name", p["line"], p["col"])
        for m in p["methods"]:
            undotted(m["name"], "Method name", m["line"], m["col"])
            check_fields(m["request"], f"{p['name']}.{m['name']} request", message=True)
            if m["response"] is not None:
                check_fields(m["response"], f"{p['name']}.{m['name']} response", message=True)


def compile_ir(ast: Dict[str, Any]) -> Dict[str, Any]:
    """Computes exact memory alignments, insertions of padding, and field byte offsets."""
    check_names(ast)
    declared_structs = {s["name"]: s for s in ast["structs"]}
    declared_enums = {e["name"]: e for e in ast["enums"]}

    # Type and protocol names share a namespace: they must be distinct
    # from each other, and from the primitive types.
    type_names: Dict[str, str] = {}
    for kind, declared in (("enum", ast["enums"]), ("struct", ast["structs"]), ("protocol", ast["protocols"])):
        for d in declared:
            if d["name"] in TYPE_MAP:
                raise DidlError(f"{kind} {d['name']} has the name of a primitive type", d["line"], d["col"])
            if d["name"] in type_names:
                raise DidlError(f"{kind} {d['name']} has the same name as {type_names[d['name']]} {d['name']}",
                                d["line"], d["col"])
            type_names[d["name"]] = kind
    layouts: Dict[str, Dict[str, Any]] = {}
    in_progress: List[str] = []  # structs whose layout is being computed, for cycle detection

    def layout_type(ref: Dict[str, Any]) -> Dict[str, Any]:
        """The size and alignment of a type reference, and for a
        sequence, its element type's."""
        f_type = ref["type"]
        if f_type in TYPE_MAP:
            size = TYPE_MAP[f_type]["size"]
            align = TYPE_MAP[f_type]["align"]
        elif f_type in declared_enums:
            base = TYPE_MAP[declared_enums[f_type]["type"]]
            size = base["size"]
            align = base["align"]
        elif f_type in declared_structs:
            # Nested structures are laid out on demand, so declaration order doesn't matter.
            # A struct can't contain itself, even in a sequence.
            if f_type in in_progress:
                cycle = " -> ".join(in_progress[in_progress.index(f_type):] + [f_type])
                raise DidlError(f"Recursive struct containment: {cycle}", ref["line"], ref["col"])
            nested = layout_struct(declared_structs[f_type])
            size = nested["total_size"]
            align = nested["alignment"]
        else:
            raise DidlError(f"Unknown type: {f_type}", ref["line"], ref["col"])

        layout = {"type": f_type, "size": size, "alignment": align}
        if f_type == "sequence":
            element = layout_type(ref["element"])
            if element["size"] == 0:
                raise DidlError(f"Sequence element type {element['type']} is empty",
                                ref["element"]["line"], ref["element"]["col"])
            layout["element"] = element
        return layout

    def layout_fields(fields: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Lays out fields in order with C-ABI padding, as for a struct body."""
        current_offset = 0
        max_alignment = 1
        compiled_fields = []

        for field in fields:
            layout = layout_type(field)
            align = layout["alignment"]
            max_alignment = max(max_alignment, align)

            # Pad current offset out to match natural field boundaries
            if current_offset % align != 0:
                current_offset += (align - (current_offset % align))

            compiled = {"name": field["name"], "type": layout["type"],
                        "offset": current_offset, "size": layout["size"], "alignment": align}
            if "element" in layout:
                compiled["element"] = layout["element"]
            compiled_fields.append(compiled)
            current_offset += layout["size"]

        # Structural trailer padding guarantees total structure aligns perfectly
        if current_offset % max_alignment != 0:
            current_offset += (max_alignment - (current_offset % max_alignment))

        return {"total_size": current_offset, "alignment": max_alignment, "fields": compiled_fields}

    def layout_struct(s: Dict[str, Any]) -> Dict[str, Any]:
        if s["name"] in layouts:
            return layouts[s["name"]]
        in_progress.append(s["name"])
        layouts[s["name"]] = {"name": s["name"], **layout_fields(s["raw_fields"])}
        in_progress.pop()
        return layouts[s["name"]]

    def compile_protocol(p: Dict[str, Any]) -> Dict[str, Any]:
        methods = []
        seen: Dict[str, Dict[str, Any]] = {}  # method name -> method
        numbers: Dict[int, str] = {}          # method number -> method name
        for m in p["methods"]:
            if m["name"] in seen:
                raise DidlError(f"Duplicate method: {p['name']}.{m['name']}", m["line"], m["col"])
            seen[m["name"]] = m
            number = m["number"]
            if not 1 <= number <= 0xffff:
                raise DidlError(f"Method number out of range (1-65535): {p['name']}.{m['name']} is {number}",
                                m["number_line"], m["number_col"])
            if number in numbers:
                raise DidlError(f"Duplicate method number {number}: {p['name']}.{m['name']} and "
                                f"{p['name']}.{numbers[number]}", m["number_line"], m["number_col"])
            numbers[number] = m["name"]
            methods.append({
                "name": m["name"],
                "number": number,
                "request": layout_fields(m["request"]),
                "response": None if m["response"] is None else layout_fields(m["response"]),
            })
        return {"name": p["name"], "methods": methods}

    def compile_enum(e: Dict[str, Any]) -> Dict[str, Any]:
        if e["type"] not in INTEGER_RANGES:
            raise DidlError(f"enum {e['name']} must be based on an integer type, not {e['type']}",
                            e["type_line"], e["type_col"])
        if not e["members"]:
            raise DidlError(f"enum {e['name']} has no members", e["line"], e["col"])
        low, high = INTEGER_RANGES[e["type"]]
        names: Dict[str, int] = {}
        values: Dict[int, str] = {}
        for m in e["members"]:
            if m["name"] in names:
                raise DidlError(f"Duplicate member: {e['name']}.{m['name']}", m["line"], m["col"])
            if not low <= m["value"] <= high:
                raise DidlError(f"Value out of range for {e['type']}: {e['name']}.{m['name']} is {m['value']}",
                                m["line"], m["col"])
            if m["value"] in values:
                raise DidlError(f"Duplicate value {m['value']}: {e['name']}.{m['name']} and "
                                f"{e['name']}.{values[m['value']]}", m["line"], m["col"])
            names[m["name"]] = m["value"]
            values[m["value"]] = m["name"]
        return {"name": e["name"], "type": e["type"],
                "members": [{"name": m["name"], "value": m["value"]} for m in e["members"]]}

    return {
        "version": IR_VERSION,
        "library": ast["libraries"][0]["name"],
        "enums": [compile_enum(e) for e in ast["enums"]],
        "structs": [layout_struct(s) for s in ast["structs"]],
        "protocols": [compile_protocol(p) for p in ast["protocols"]],
    }



def main() -> int:
    ap = argparse.ArgumentParser(description="Compile a .didl file into a .dir IR file.")
    ap.add_argument("input", help="source .didl file")
    ap.add_argument("-o", "--output", help="output .dir file, or - for stdout (default: input with .dir extension)")
    args = ap.parse_args()

    output = args.output or os.path.splitext(args.input)[0] + ".dir"
    try:
        with open(args.input) as f:
            ir = compile_ir(Parser(lex(f.read())).parse())
    except OSError as e:
        print(f"didlc: {e}", file=sys.stderr)
        return 1
    except DidlError as e:
        print(f"{args.input}:{e.line}:{e.col}: error: {e}", file=sys.stderr)
        return 1

    text = json.dumps(ir, indent=2) + "\n"
    if output == "-":
        sys.stdout.write(text)
    else:
        with open(output, "w") as f:
            f.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
